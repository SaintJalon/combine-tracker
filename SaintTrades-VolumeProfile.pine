//@version=6
// SaintTrades Fixed Range Volume Profile
// Builds a volume profile over a fixed range of bars, marks the POC / VAH / VAL,
// and lays out a mechanical trade plan (entry, stop, two targets) off those levels.
indicator('SaintTrades Volume Profile', shorttitle='ST VP', overlay=true, max_boxes_count=500, max_lines_count=100, max_labels_count=100, max_bars_back=5000)

// ----------------------------------------------------------------------------
// Inputs
// ----------------------------------------------------------------------------
grpRange = 'Range'
rangeMode = input.string('Prior Session (Day)', title='Range', options=['Fixed Bars', 'Session (Day)', 'Week', 'Month', 'Prior Session (Day)', 'Prior Week', 'Visible Range'], group=grpRange, tooltip='Which block of bars the profile is built from. The Prior modes read the last completed period, so the levels are fixed for the whole of the current one.')
lookback = input.int(200, title='Lookback Bars  (Fixed Bars only)', minval=10, maxval=4999, group=grpRange)
closedOnly = input.bool(true, title='Closed Bars Only', group=grpRange, tooltip='Leave the forming bar out of the profile, so the levels only move when a bar closes instead of on every tick.')

grpProf = 'Profile'
rowMode = input.string('Fixed Ticks', title='Row Size', options=['Auto (N Rows)', 'Fixed Ticks'], group=grpProf, tooltip='Auto slices the range into N rows, so every row boundary shifts when the range changes. Fixed Ticks pins the rows to an absolute price grid, which holds the POC and value area edges still.')
rows = input.int(48, title='Rows  (Auto only)', minval=10, maxval=150, group=grpProf, tooltip='Price buckets the range is sliced into. More rows means a finer POC and a slower calculation.')
rowTicks = input.int(20, title='Ticks Per Row  (Fixed Ticks only)', minval=1, maxval=1000, group=grpProf, tooltip='Row height when Row Size is Fixed Ticks.')
vaPct = input.float(70, title='Value Area %', minval=30, maxval=95, step=1, group=grpProf)
weightBy = input.string('Volume', title='Weight By', options=['Volume', 'Bar Count (TPO)'], group=grpProf, tooltip='Bar Count builds a TPO style profile, and is used automatically on symbols with no volume data.')

grpDisp = 'Display'
showProfile = input.bool(true, title='Show Profile', group=grpDisp)
profileSide = input.string('Right of Range', title='Placement', options=['Right of Range', 'Inside Range'], group=grpDisp)
profWidth = input.int(60, title='Profile Width (bars)', minval=5, maxval=200, group=grpDisp)
profGap = input.int(5, title='Gap From Last Bar', minval=0, maxval=100, group=grpDisp)
splitUpDown = input.bool(true, title='Split Buy / Sell Volume', group=grpDisp)
colUp = input.color(color.new(#26a69a, 55), title='Up', inline='vpcol', group=grpDisp)
colDn = input.color(color.new(#ef5350, 55), title='Down', inline='vpcol', group=grpDisp)
colPoc = input.color(#ffb300, title='POC', inline='lvlcol', group=grpDisp)
colVa = input.color(#42a5f5, title='Value Area', inline='lvlcol', group=grpDisp)
colEdge = input.color(color.new(#9e9e9e, 20), title='Range H/L', inline='lvlcol', group=grpDisp)
vaFill = input.bool(true, title='Shade Value Area', group=grpDisp)
showEdges = input.bool(true, title='Show Range High / Low', group=grpDisp)
lvlExtend = input.int(20, title='Extend Levels (bars)', minval=0, maxval=200, group=grpDisp)

grpPlan = 'Trade Plan'
showPlan = input.bool(true, title='Show Trade Plan', group=grpPlan)
planMode = input.string('Auto', title='Setup Type', options=['Auto', 'Rotation (fade to POC)', 'Breakout (continuation)'], group=grpPlan, tooltip='Auto plans a rotation while price sits inside the profile range, and a breakout retest once price trades outside it.')
dirFilter = input.string('Both', title='Direction Filter', options=['Both', 'Long Only', 'Short Only'], group=grpPlan)
dirBandPct = input.float(5, title='Direction Deadband (% of VA)', minval=0, maxval=50, step=1, group=grpPlan, tooltip='How far past the POC price has to trade before the plan is allowed to flip direction. Stops the setup oscillating while price sits on the POC.')
stopMode = input.string('Value Edge', title='Stop Anchor', options=['Profile Extreme', 'Value Edge', 'ATR'], group=grpPlan)
atrLen = input.int(14, title='ATR Length', minval=1, group=grpPlan)
slBufATR = input.float(0.25, title='Stop Buffer (ATR)', minval=0, step=0.05, group=grpPlan, tooltip='Padding beyond the structural stop level.')
slATRMult = input.float(1.5, title='ATR Stop Multiple  (ATR anchor only)', minval=0.1, step=0.1, group=grpPlan, tooltip='Only used when Stop Anchor is set to ATR.')
tpMode = input.string('R Multiple', title='Targets', options=['R Multiple', 'Profile Structure'], group=grpPlan)
rr1 = input.float(1.5, title='TP1 R', minval=0.1, step=0.1, inline='rr', group=grpPlan)
rr2 = input.float(3.0, title='TP2 R', minval=0.1, step=0.1, inline='rr', group=grpPlan, tooltip='R multiples for the targets. Ignored when Targets is set to Profile Structure.')
planExtend = input.int(40, title='Plan Line Length (bars)', minval=5, maxval=200, group=grpPlan)
colEntry = input.color(#42a5f5, title='Entry', inline='plancol', group=grpPlan)
colSl = input.color(#ef5350, title='Stop', inline='plancol', group=grpPlan)
colTp = input.color(#26a69a, title='Target', inline='plancol', group=grpPlan)

grpRisk = 'Position Size'
showSize = input.bool(true, title='Suggest Size', group=grpRisk)
riskDollars = input.float(300, title='Risk Per Trade ($)', minval=1, step=25, group=grpRisk)

grpTbl = 'Table'
showTable = input.bool(true, title='Show Table', group=grpTbl)
tblPos = input.string('Bottom Right', title='Position', options=['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left', 'Middle Right'], group=grpTbl)
tblSize = input.string('Small', title='Text Size', options=['Tiny', 'Small', 'Normal'], group=grpTbl)

// ----------------------------------------------------------------------------
// Range length
// ----------------------------------------------------------------------------
chD = timeframe.change('D')
chW = timeframe.change('W')
chM = timeframe.change('M')
newPeriod = (rangeMode == 'Session (Day)' or rangeMode == 'Prior Session (Day)') ? chD : (rangeMode == 'Week' or rangeMode == 'Prior Week') ? chW : rangeMode == 'Month' ? chM : false

var int barsInPeriod = 0
var int barsPrevPeriod = 0
if newPeriod
    barsPrevPeriod := barsInPeriod
    barsInPeriod := 1
else
    barsInPeriod += 1

visibleBars() =>
    int cnt = 0
    if not na(chart.left_visible_bar_time)
        for i = 0 to 4998
            if i > bar_index
                break
            if time[i] < chart.left_visible_bar_time
                break
            cnt += 1
    cnt

int visBars = visibleBars()
bool priorMode = rangeMode == 'Prior Session (Day)' or rangeMode == 'Prior Week'

// A prior-period profile starts behind every bar of the current period, so it
// stops moving the moment that period opens.
int rangeOffset = priorMode ? barsInPeriod : (closedOnly ? 1 : 0)
// Dropping the forming bar shortens the window as well as shifting it. Counting
// a whole period from one bar back would reach a bar into the period before it.
int rangeWant = rangeMode == 'Fixed Bars' ? lookback : rangeMode == 'Visible Range' ? visBars - rangeOffset : priorMode ? barsPrevPeriod : barsInPeriod - rangeOffset

// Pine can only address a bounded slice of history. Clamping the offset to fit
// would slide the window forward into the current period and draw confident,
// wrong levels, so an unreachable range is reported instead of drawn.
int rangeRoom = math.min(bar_index, 4998) - rangeOffset + 1
string rangeIssue = rangeRoom < 2 ? 'range starts ' + str.tostring(rangeOffset) + ' bars back' : rangeWant < 2 ? 'not enough bars in range' : ''
int rangeLen = rangeIssue != '' ? 2 : math.min(rangeWant, rangeRoom)
bool rangeCut = rangeIssue == '' and rangeWant > rangeLen

atr = ta.atr(atrLen)
hasVolume = ta.cum(nz(volume)) > 0
useTpo = weightBy == 'Bar Count (TPO)' or not hasVolume

// ----------------------------------------------------------------------------
// State carried between bars, so the alerts can read the live profile
// ----------------------------------------------------------------------------
var float pocPrice = na
var float vahPrice = na
var float valPrice = na
var float planEntry = na
var float planStop = na
var float planTp1 = na
var float planTp2 = na
var string planDir = 'None'
var string planKind = 'None'
var string planNote = ''
var string dirLatch = 'None'

var array<box> vpBoxes = array.new<box>()
var array<line> vpLines = array.new<line>()
var array<label> vpLabels = array.new<label>()

tblPosition = tblPos == 'Top Left' ? position.top_left : tblPos == 'Bottom Right' ? position.bottom_right : tblPos == 'Bottom Left' ? position.bottom_left : tblPos == 'Middle Right' ? position.middle_right : position.top_right
txtSize = tblSize == 'Tiny' ? size.tiny : tblSize == 'Normal' ? size.normal : size.small
var table tbl = table.new(tblPosition, 2, 12, bgcolor=color.new(#131722, 12), border_color=color.new(#5d606b, 60), border_width=1, frame_color=color.new(#5d606b, 40), frame_width=1)

// ----------------------------------------------------------------------------
// Helpers
// ----------------------------------------------------------------------------
clearDrawings() =>
    if array.size(vpBoxes) > 0
        for i = 0 to array.size(vpBoxes) - 1
            box.delete(array.get(vpBoxes, i))
        array.clear(vpBoxes)
    if array.size(vpLines) > 0
        for i = 0 to array.size(vpLines) - 1
            line.delete(array.get(vpLines, i))
        array.clear(vpLines)
    if array.size(vpLabels) > 0
        for i = 0 to array.size(vpLabels) - 1
            label.delete(array.get(vpLabels, i))
        array.clear(vpLabels)

mkLevel(int x1, int x2, float y, color c, int w, string txt, bool dashed) =>
    ln = line.new(x1, y, x2, y, xloc=xloc.bar_index, color=c, style=dashed ? line.style_dashed : line.style_solid, width=w)
    array.push(vpLines, ln)
    if txt != ''
        lb = label.new(x2, y, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=c, size=size.small)
        array.push(vpLabels, lb)

cellKV(int r, string k, string v, color vc) =>
    table.cell(tbl, 0, r, k, text_color=color.new(color.silver, 0), text_size=txtSize, text_halign=text.align_left)
    table.cell(tbl, 1, r, v, text_color=vc, text_size=txtSize, text_halign=text.align_right)

fmt(float p) => str.tostring(p, format.mintick)

rt(float p) => na(p) ? na : math.round(p / syminfo.mintick) * syminfo.mintick

// ----------------------------------------------------------------------------
// Build and draw, on the last bar only
// ----------------------------------------------------------------------------
if barstate.islast and rangeIssue != ''
    clearDrawings()
    pocPrice := na
    vahPrice := na
    valPrice := na
    planEntry := na
    planDir := 'None'
    planKind := 'No setup'
    if showTable
        table.clear(tbl, 0, 0, 1, 11)
        cellKV(0, 'Profile', 'unavailable', color.new(#ffb300, 0))
        cellKV(1, 'Why', rangeIssue, color.gray)
        cellKV(2, '', rangeRoom < 2 ? 'try a higher timeframe' : '', color.gray)

if barstate.islast and rangeIssue == ''
    clearDrawings()

    // --- range extremes ---
    float hi = high[rangeOffset]
    float lo = low[rangeOffset]
    for i = rangeOffset to rangeOffset + rangeLen - 1
        float h = high[i]
        float l = low[i]
        if not na(h) and not na(l)
            hi := math.max(nz(hi, h), h)
            lo := math.min(nz(lo, l), l)

    // Row grid. 'Auto' re-slices the range every time it changes, which walks
    // every boundary. 'Fixed Ticks' lays the rows on an absolute price grid so
    // the boundaries stay put and only the volume in them moves.
    float step = (hi - lo) / rows
    float gridLo = lo
    int nRows = rows
    if rowMode == 'Fixed Ticks'
        step := rowTicks * syminfo.mintick
        for _k = 0 to 12
            gridLo := math.floor(lo / step) * step
            nRows := int(math.ceil((hi - gridLo) / step)) + 1
            if nRows <= 200
                break
            step *= 2
        nRows := math.max(2, math.min(nRows, 200))
    step := step <= 0 ? syminfo.mintick : step

    // --- spread each bar's volume across every row it spans ---
    upVol = array.new_float(nRows, 0.0)
    dnVol = array.new_float(nRows, 0.0)

    for i = rangeOffset to rangeOffset + rangeLen - 1
        float bh = high[i]
        float bl = low[i]
        if na(bh) or na(bl)
            continue
        float span = bh - bl
        float v = useTpo ? 1.0 : nz(volume[i])
        bool isUp = close[i] >= open[i]
        int r1 = math.max(0, math.min(nRows - 1, int(math.floor((bl - gridLo) / step))))
        int r2 = math.max(0, math.min(nRows - 1, int(math.floor((bh - gridLo) / step))))
        for r = r1 to r2
            float rBot = gridLo + r * step
            float rTop = rBot + step
            float overlap = math.min(bh, rTop) - math.max(bl, rBot)
            float share = span <= 0 ? 1.0 : math.max(overlap, 0) / span
            float add = v * share
            if isUp
                array.set(upVol, r, array.get(upVol, r) + add)
            else
                array.set(dnVol, r, array.get(dnVol, r) + add)

    // --- POC and value area ---
    totVol = array.new_float(nRows, 0.0)
    float grandTotal = 0.0
    float maxRow = 0.0
    int pocIdx = 0
    for r = 0 to nRows - 1
        float t = array.get(upVol, r) + array.get(dnVol, r)
        array.set(totVol, r, t)
        grandTotal += t
        if t > maxRow
            maxRow := t
            pocIdx := r
    maxRow := maxRow <= 0 ? 1.0 : maxRow

    int vaUp = pocIdx
    int vaDn = pocIdx
    float acc = array.get(totVol, pocIdx)
    float vaTarget = grandTotal * vaPct / 100.0
    for _i = 0 to nRows - 1
        if acc >= vaTarget
            break
        float nUp = vaUp < nRows - 1 ? array.get(totVol, vaUp + 1) : -1.0
        float nDn = vaDn > 0 ? array.get(totVol, vaDn - 1) : -1.0
        if nUp < 0 and nDn < 0
            break
        if nUp >= nDn
            vaUp += 1
            acc += nUp
        else
            vaDn -= 1
            acc += nDn

    // Snapped to the tick grid, otherwise a row boundary lands off-tick and the
    // line is drawn at one price while its label prints the rounded one.
    pocPrice := rt(gridLo + (pocIdx + 0.5) * step)
    // The grid row holding an extreme extends past it, so an unclamped edge can
    // print above the range high or below the range low.
    vahPrice := math.min(rt(gridLo + (vaUp + 1) * step), hi)
    valPrice := math.max(rt(gridLo + vaDn * step), lo)

    int lastIdx = bar_index
    int startIdx = lastIdx - rangeOffset - (rangeLen - 1)
    int anchor = profileSide == 'Right of Range' ? lastIdx + profGap : startIdx
    int lvlRight = lastIdx + math.max(lvlExtend, profileSide == 'Right of Range' ? profGap + profWidth + 2 : 2)

    // --- histogram ---
    if showProfile
        for r = 0 to nRows - 1
            float rBot = gridLo + r * step
            float rTop = rBot + step
            float u = array.get(upVol, r)
            float d = array.get(dnVol, r)
            bool inVa = r >= vaDn and r <= vaUp
            int wUp = int(math.round(profWidth * (splitUpDown ? u : u + d) / maxRow))
            int wDn = splitUpDown ? int(math.round(profWidth * d / maxRow)) : 0
            color cu = r == pocIdx ? color.new(colPoc, 45) : inVa ? colUp : color.new(colUp, 80)
            color cd = r == pocIdx ? color.new(colPoc, 45) : inVa ? colDn : color.new(colDn, 80)
            if wUp > 0
                array.push(vpBoxes, box.new(anchor, rTop, anchor + wUp, rBot, xloc=xloc.bar_index, border_color=color.new(color.black, 100), bgcolor=cu))
            if wDn > 0
                array.push(vpBoxes, box.new(anchor + wUp, rTop, anchor + wUp + wDn, rBot, xloc=xloc.bar_index, border_color=color.new(color.black, 100), bgcolor=cd))

    // --- value area shading and levels ---
    if vaFill
        // stop the shading at the last bar so it does not wash out the up/down
        // rows of the histogram sitting to the right
        int vaRight = profileSide == 'Right of Range' ? lastIdx : lvlRight
        array.push(vpBoxes, box.new(startIdx, vahPrice, vaRight, valPrice, xloc=xloc.bar_index, border_color=color.new(color.black, 100), bgcolor=color.new(colVa, 93)))

    mkLevel(startIdx, lvlRight, pocPrice, colPoc, 2, 'POC ' + fmt(pocPrice), false)
    mkLevel(startIdx, lvlRight, vahPrice, colVa, 1, 'VAH ' + fmt(vahPrice), true)
    mkLevel(startIdx, lvlRight, valPrice, colVa, 1, 'VAL ' + fmt(valPrice), true)
    if showEdges
        mkLevel(startIdx, lvlRight, hi, colEdge, 1, 'RH ' + fmt(hi), true)
        mkLevel(startIdx, lvlRight, lo, colEdge, 1, 'RL ' + fmt(lo), true)

    // ------------------------------------------------------------------------
    // Trade plan
    // ------------------------------------------------------------------------
    planEntry := na
    planStop := na
    planTp1 := na
    planTp2 := na
    planDir := 'None'
    planNote := ''
    planKind := showPlan ? 'None' : 'Off'

    if showPlan
        float px = close
        string kind = planMode == 'Auto' ? (px > hi or px < lo ? 'Breakout' : 'Rotation') : planMode == 'Breakout (continuation)' ? 'Breakout' : 'Rotation'

        // Direction only flips once price is clear of the POC by the deadband,
        // otherwise the setup thrashes every time price ticks across it.
        float dirBand = (vahPrice - valPrice) * dirBandPct / 100.0
        if px < pocPrice - dirBand
            dirLatch := 'Long'
        else if px > pocPrice + dirBand
            dirLatch := 'Short'
        bool rotLong = dirLatch == 'None' ? px < pocPrice : dirLatch == 'Long'
        bool isLong = kind == 'Breakout' ? (px > hi ? true : px < lo ? false : rotLong) : rotLong

        if (isLong and dirFilter == 'Short Only') or (not isLong and dirFilter == 'Long Only')
            planKind := 'Filtered'
        else
            float buf = atr * slBufATR
            float vaHeight = vahPrice - valPrice
            float entry = na
            float sl = na

            if kind == 'Rotation'
                // fade the far side of value back toward the POC
                entry := isLong ? valPrice : vahPrice
                // The buffer pads the row, the way it pads the structural
                // level under every other anchor. Taking the larger of the two
                // threw away any buffer narrower than one row without saying
                // so, and one row is already the floor minRisk enforces below.
                float edgeStop = step + buf
                sl := stopMode == 'ATR' ? (isLong ? entry - atr * slATRMult : entry + atr * slATRMult) : stopMode == 'Value Edge' ? (isLong ? entry - edgeStop : entry + edgeStop) : (isLong ? lo - buf : hi + buf)
            else
                // buy the retest of the level price broke out through
                entry := isLong ? (px > hi ? hi : vahPrice) : (px < lo ? lo : valPrice)
                sl := stopMode == 'ATR' ? (isLong ? entry - atr * slATRMult : entry + atr * slATRMult) : stopMode == 'Value Edge' ? (isLong ? vahPrice - buf : valPrice + buf) : (isLong ? valPrice - buf : vahPrice + buf)

            // Snap to the tick grid so the numbers are prices you can key in,
            // and so the tick count and R multiples are exact.
            entry := rt(entry)
            sl := rt(sl)
            // A structural stop can land on top of the entry, or the wrong side
            // of it, when the row grid puts a value edge past the range extreme
            // the entry sits on. Hold it at least one row the correct way.
            float minRisk = math.max(step, syminfo.mintick)
            bool wrongSide = isLong ? sl >= entry : sl <= entry
            if wrongSide or math.abs(entry - sl) < minRisk
                sl := rt(isLong ? entry - minRisk : entry + minRisk)
            float risk = math.abs(entry - sl)

            float tp1 = na
            float tp2 = na
            if tpMode == 'R Multiple'
                tp1 := isLong ? entry + risk * rr1 : entry - risk * rr1
                tp2 := isLong ? entry + risk * rr2 : entry - risk * rr2
            else
                if kind == 'Rotation'
                    tp1 := pocPrice
                    tp2 := isLong ? vahPrice : valPrice
                else
                    tp1 := isLong ? entry + vaHeight : entry - vaHeight
                    tp2 := isLong ? entry + (hi - lo) : entry - (hi - lo)
                // fall back to R multiples if a structural target sits the wrong side of entry
                if (isLong and tp1 <= entry) or (not isLong and tp1 >= entry)
                    tp1 := isLong ? entry + risk * rr1 : entry - risk * rr1
                if (isLong and tp2 <= tp1) or (not isLong and tp2 >= tp1)
                    tp2 := isLong ? entry + risk * rr2 : entry - risk * rr2

            tp1 := rt(tp1)
            tp2 := rt(tp2)

            // Refuse to print a plan that price has already invalidated, rather
            // than showing a stop that is behind the market or a target that has
            // already been paid out.
            if dirLatch == 'None'
                planNote := 'price sitting on the POC'
            else if (isLong and px <= sl) or (not isLong and px >= sl)
                planNote := 'stop already breached'
            else if (isLong and px >= tp2) or (not isLong and px <= tp2)
                planNote := 'price already past TP2'

            if planNote != ''
                planKind := 'No setup'
                planDir := 'None'
            else
                planEntry := entry
                planStop := sl
                planTp1 := tp1
                planTp2 := tp2
                planDir := isLong ? 'Long' : 'Short'
                planKind := kind

                int px1 = lastIdx + 1
                int px2 = lastIdx + planExtend
                array.push(vpBoxes, box.new(px1, math.max(entry, sl), px2, math.min(entry, sl), xloc=xloc.bar_index, border_color=color.new(color.black, 100), bgcolor=color.new(colSl, 92)))
                array.push(vpBoxes, box.new(px1, math.max(tp2, entry), px2, math.min(tp2, entry), xloc=xloc.bar_index, border_color=color.new(color.black, 100), bgcolor=color.new(colTp, 92)))
                mkLevel(px1, px2, entry, colEntry, 2, 'ENTRY ' + fmt(entry), false)
                mkLevel(px1, px2, sl, colSl, 2, 'SL ' + fmt(sl), false)
                mkLevel(px1, px2, tp1, colTp, 1, 'TP1 ' + fmt(tp1), true)
                mkLevel(px1, px2, tp2, colTp, 2, 'TP2 ' + fmt(tp2), false)

    // ------------------------------------------------------------------------
    // Table
    // ------------------------------------------------------------------------
    if showTable
        string srcTxt = useTpo ? 'TPO' : 'Volume'
        cellKV(0, 'Profile', str.tostring(rangeLen) + (rangeCut ? ' of ' + str.tostring(rangeWant) : '') + ' bars / ' + srcTxt, rangeCut ? color.new(#ffb300, 0) : color.white)
        cellKV(1, 'Range High', fmt(hi), colEdge)
        cellKV(2, 'VAH', fmt(vahPrice), colVa)
        cellKV(3, 'POC', fmt(pocPrice), colPoc)
        cellKV(4, 'VAL', fmt(valPrice), colVa)
        cellKV(5, 'Range Low', fmt(lo), colEdge)

        string loc = close > vahPrice ? 'Above value' : close < valPrice ? 'Below value' : 'In value'
        loc := close > hi ? 'Above range' : close < lo ? 'Below range' : loc
        cellKV(6, 'Price', loc, close > vahPrice ? colTp : close < valPrice ? colSl : color.white)

        if na(planEntry)
            string why = planKind == 'Filtered' ? 'Filtered out' : planKind == 'No setup' ? 'No setup' : 'Off'
            cellKV(7, 'Setup', why, planKind == 'No setup' ? color.new(#ffb300, 0) : color.gray)
            cellKV(8, planKind == 'No setup' ? 'Why' : '', planNote, color.gray)
            cellKV(9, '', '', color.gray)
            cellKV(10, '', '', color.gray)
            cellKV(11, '', '', color.gray)
        else
            float riskPts = math.abs(planEntry - planStop)
            float rMult = riskPts > 0 ? math.abs(planTp2 - planEntry) / riskPts : na
            cellKV(7, 'Setup', planKind + ' ' + planDir, planDir == 'Long' ? colTp : colSl)
            string ordType = planDir == 'Long' ? (planEntry > close ? 'buy stop' : 'buy limit') : (planEntry < close ? 'sell stop' : 'sell limit')
            cellKV(8, 'Entry', fmt(planEntry) + '  ' + ordType, colEntry)
            cellKV(9, 'Stop', fmt(planStop) + '  (' + str.tostring(riskPts / syminfo.mintick, '#') + ' tk)', colSl)
            cellKV(10, 'Targets', fmt(planTp1) + ' / ' + fmt(planTp2) + '  ' + str.tostring(rMult, '#.#') + 'R', colTp)
            float perUnit = riskPts * syminfo.pointvalue
            float qty = perUnit > 0 ? riskDollars / perUnit : na
            cellKV(11, 'Size', not showSize ? 'off' : na(qty) ? 'n/a' : str.tostring(math.floor(qty), '#') + ' @ $' + str.tostring(perUnit, '#.##') + ' ea', color.white)
