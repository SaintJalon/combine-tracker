//@version=6
// SaintTrades Volume Profile - Strategy
//
// The trade plan from the SaintTrades Volume Profile indicator, wired into the
// Strategy Tester so the rules can be measured instead of eyeballed.
//
// Two things make this an honest test rather than a flattering one:
//
//   The profile is built from a COMPLETED period only. Levels for today come
//   from yesterday's bars and never change during the session, so no order is
//   ever placed using information the bar had not produced yet. It is
//   accumulated as the period runs rather than read back from its last bar, so
//   nothing looks further back than one bar and the chart timeframe stops
//   deciding whether a session can be profiled at all.
//
//   Commission and slippage are on by default. A twenty tick stop looks superb
//   with neither and is usually a loser with both. Adjust them in Properties to
//   match your broker before you believe any number this prints.
strategy('SaintTrades Volume Profile Strategy', shorttitle='ST VP Strat', overlay=true, max_bars_back=5000, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=1, pyramiding=0)

// ----------------------------------------------------------------------------
// Inputs
// ----------------------------------------------------------------------------
grpRange = 'Range'
rangeMode = input.string('Prior Session (Day)', title='Range', options=['Prior Session (Day)', 'Prior Week'], group=grpRange, tooltip='Only completed periods are offered. A developing profile would let the strategy trade against levels the bar had not finished forming.')

grpProf = 'Profile'
rowMode = input.string('Fixed Ticks', title='Row Size', options=['Auto (N Rows)', 'Fixed Ticks'], group=grpProf)
rows = input.int(48, title='Rows  (Auto only)', minval=10, maxval=150, group=grpProf)
rowTicks = input.int(20, title='Ticks Per Row  (Fixed Ticks only)', minval=1, maxval=1000, group=grpProf, tooltip='Also sets the stop distance, since a Value Edge stop is held one row from the entry.')
vaPct = input.float(70, title='Value Area %', minval=30, maxval=95, step=1, group=grpProf)
weightBy = input.string('Volume', title='Weight By', options=['Volume', 'Bar Count (TPO)'], group=grpProf)

grpPlan = 'Trade Plan'
planMode = input.string('Auto', title='Setup Type', options=['Auto', 'Rotation (fade to POC)', 'Breakout (continuation)'], group=grpPlan)
dirFilter = input.string('Both', title='Direction Filter', options=['Both', 'Long Only', 'Short Only'], group=grpPlan)
dirBandPct = input.float(5, title='Direction Deadband (% of VA)', minval=0, maxval=50, step=1, group=grpPlan)
entryStyle = input.string('Market (enter now)', title='Entry', options=['Market (enter now)', 'Limit at the level'], group=grpPlan, tooltip='Market takes the trade where price is and stops out at the level that proves it wrong. Limit rests the order on the value edge and only trades if price comes back to it.')
stopMode = input.string('Value Edge', title='Stop Anchor', options=['Profile Extreme', 'Value Edge', 'ATR'], group=grpPlan)
atrLen = input.int(14, title='ATR Length', minval=1, group=grpPlan)
slBufATR = input.float(0.25, title='Stop Buffer (ATR)', minval=0, step=0.05, group=grpPlan)
slATRMult = input.float(1.5, title='ATR Stop Multiple  (ATR anchor only)', minval=0.1, step=0.1, group=grpPlan)
tpMode = input.string('R Multiple', title='Targets', options=['R Multiple', 'Profile Structure'], group=grpPlan)
rr1 = input.float(1.5, title='TP1 R', minval=0.1, step=0.1, inline='rr', group=grpPlan)
rr2 = input.float(3.0, title='TP2 R', minval=0.1, step=0.1, inline='rr', group=grpPlan)
tp1Pct = input.int(50, title='% Off At TP1', minval=0, maxval=100, group=grpPlan, tooltip='0 runs the whole position to TP2. 100 treats TP1 as the only target.')

grpRisk = 'Risk'
riskDollars = input.float(300, title='Risk Per Trade ($)', minval=1, step=25, group=grpRisk)
maxContracts = input.int(10, title='Max Contracts', minval=1, group=grpRisk)

grpWhen = 'When To Trade'
useSession = input.bool(true, title='Restrict To Session', group=grpWhen)
sessionStr = input.session('0930-1600', title='Session', group=grpWhen, tooltip='Entries are only placed inside this window. Exits always work.')
maxTrades = input.int(2, title='Max Trades Per Period', minval=1, maxval=20, group=grpWhen)
flatAtEnd = input.bool(true, title='Flat At Period Roll', group=grpWhen, tooltip='Close anything still open when a new session begins, rather than carrying it.')

grpDisp = 'Display'
showLevels = input.bool(true, title='Plot Levels', group=grpDisp)

// ----------------------------------------------------------------------------
// Period tracking
// ----------------------------------------------------------------------------
chD = timeframe.change('D')
chW = timeframe.change('W')
newPeriod = rangeMode == 'Prior Week' ? chW : chD

atr = ta.atr(atrLen)
hasVolume = ta.cum(nz(volume)) > 0
useTpo = weightBy == 'Bar Count (TPO)' or not hasVolume

rt(float p) => na(p) ? na : math.round(p / syminfo.mintick) * syminfo.mintick

rowStep(float h, float l) =>
    float s = rowTicks * syminfo.mintick
    if rowMode == 'Auto (N Rows)' and not na(h) and not na(l) and h > l
        s := math.max(syminfo.mintick, math.round((h - l) / rows / syminfo.mintick) * syminfo.mintick)
    s <= 0 ? syminfo.mintick : s

// ----------------------------------------------------------------------------
// Profile of the completed period
//
// Each bar files itself into the period it belongs to as it closes, into a map
// keyed by absolute price grid row. A period roll freezes the finished map into
// the levels and starts an empty one. Reading backwards from the final bar, as
// this used to, could not reach a session more than a thousand bars long, which
// on a one minute chart is every session.
// ----------------------------------------------------------------------------
var float pPoc = na
var float pVah = na
var float pVal = na
var float pHi = na
var float pLo = na
var float pStep = na

var map<int, float> curVol = map.new<int, float>()
var float curHi = na
var float curLo = na
var int curBars = 0
var float gStep = na

// A history bar is finished by definition; isconfirmed only has to settle the
// live one. Map mutations are not rolled back between ticks, so an ungated roll
// would freeze the finished period on the first tick of a new one and then
// overwrite it with the empty map on every tick after.
bool closedBar = barstate.ishistory or barstate.isconfirmed

if newPeriod and closedBar
    if curBars >= 10 and map.size(curVol) > 0 and not na(curHi) and not na(curLo) and not na(gStep) and gStep > 0
        array<int> keys = map.keys(curVol)
        int minK = array.min(keys)
        int maxK = array.max(keys)
        int raw = maxK - minK + 1
        int grp = math.max(1, int(math.ceil(raw / 200.0)))
        int nRows = math.max(2, int(math.ceil(raw / float(grp))))
        float step = gStep * grp
        float gridLo = minK * gStep

        array<float> totVol = array.new<float>(nRows, 0.0)
        float grandTotal = 0.0
        for i = 0 to array.size(keys) - 1
            int k = array.get(keys, i)
            int ix = math.max(0, math.min(nRows - 1, int(math.floor((k - minK) / float(grp)))))
            float v = nz(map.get(curVol, k))
            array.set(totVol, ix, array.get(totVol, ix) + v)
            grandTotal += v

        float maxRow = 0.0
        for r = 0 to nRows - 1
            maxRow := math.max(maxRow, array.get(totVol, r))

        // Keeping the first row to hit the maximum pins the POC to the lowest
        // tied price. Ties are the rule in TPO mode, where every bar weighs one.
        int pocIdx = 0
        float pocMid = (nRows - 1) / 2.0
        float pocBest = nRows + 1.0
        for r = 0 to nRows - 1
            if array.get(totVol, r) >= maxRow
                float dist = math.abs(r - pocMid)
                if dist < pocBest
                    pocBest := dist
                    pocIdx := r

        int vaUp = pocIdx
        int vaDn = pocIdx
        float acc = array.get(totVol, pocIdx)
        float vaTarget = grandTotal * vaPct / 100.0
        // The conventional Market Profile walk weighs the next TWO rows on each
        // side and takes the heavier pair whole. Bounds are checked before any
        // row is read, never inside a ternary, so no out of range index forms.
        for _i = 0 to nRows - 1
            if acc >= vaTarget
                break
            float sumUp = -1.0
            int upRows = 0
            if vaUp + 1 <= nRows - 1
                sumUp := array.get(totVol, vaUp + 1)
                upRows := 1
                if vaUp + 2 <= nRows - 1
                    sumUp += array.get(totVol, vaUp + 2)
                    upRows := 2
            float sumDn = -1.0
            int dnRows = 0
            if vaDn - 1 >= 0
                sumDn := array.get(totVol, vaDn - 1)
                dnRows := 1
                if vaDn - 2 >= 0
                    sumDn += array.get(totVol, vaDn - 2)
                    dnRows := 2
            if upRows == 0 and dnRows == 0
                break
            if sumUp >= sumDn
                vaUp += upRows
                acc += sumUp
            else
                vaDn -= dnRows
                acc += sumDn

        pPoc := rt(gridLo + (pocIdx + 0.5) * step)
        pVah := math.min(rt(gridLo + (vaUp + 1) * step), curHi)
        pVal := math.max(rt(gridLo + vaDn * step), curLo)
        pHi := curHi
        pLo := curLo
        pStep := step
    else
        // A period too thin to profile must not leave the last one's levels
        // standing. Stale levels keep placing orders against a range that is
        // days old, and the fills look plausible enough to pass unnoticed.
        pPoc := na
        pVah := na
        pVal := na
        pHi := na
        pLo := na
        pStep := na

    map.clear(curVol)
    curHi := na
    curLo := na
    curBars := 0
    // Auto rows have no range to slice until a period is over, so a new period
    // borrows the row height the one before it settled on.
    gStep := rowStep(pHi, pLo)

if na(gStep)
    gStep := math.max(syminfo.mintick, rowTicks * syminfo.mintick)

if closedBar and gStep > 0
    float bh = high
    float bl = low
    if not na(bh) and not na(bl)
        curHi := na(curHi) ? bh : math.max(curHi, bh)
        curLo := na(curLo) ? bl : math.min(curLo, bl)
        curBars += 1
        float span = bh - bl
        float v = useTpo ? 1.0 : nz(volume)
        int r1 = int(math.floor(bl / gStep))
        int r2 = int(math.floor(bh / gStep))
        if r2 >= r1 and r2 - r1 <= 400
            for r = r1 to r2
                float rBot = r * gStep
                float overlap = math.min(bh, rBot + gStep) - math.max(bl, rBot)
                float share = span <= 0 ? 1.0 : math.max(overlap, 0) / span
                map.put(curVol, r, nz(map.get(curVol, r)) + v * share)

// ----------------------------------------------------------------------------
// Plan for this bar, off the fixed levels
// ----------------------------------------------------------------------------
var string dirLatch = 'None'

bool ready = not na(pPoc) and not na(pStep)
float px = close

float planEntry = na
float planStop = na
float planTp1 = na
float planTp2 = na
bool planLong = false
bool planValid = false

if ready
    string kind = planMode == 'Auto' ? (px > pHi or px < pLo ? 'Breakout' : 'Rotation') : planMode == 'Breakout (continuation)' ? 'Breakout' : 'Rotation'

    float dirBand = (pVah - pVal) * dirBandPct / 100.0
    if px < pPoc - dirBand
        dirLatch := 'Long'
    else if px > pPoc + dirBand
        dirLatch := 'Short'
    bool rotLong = dirLatch == 'None' ? px < pPoc : dirLatch == 'Long'
    bool isLong = kind == 'Breakout' ? (px > pHi ? true : px < pLo ? false : rotLong) : rotLong

    bool filtered = (isLong and dirFilter == 'Short Only') or (not isLong and dirFilter == 'Long Only')

    if not filtered and dirLatch != 'None'
        float buf = atr * slBufATR
        float entry = na
        float sl = na

        // The buffer pads the row, the way it pads the structural level under
        // every other anchor. Taking the larger of the two threw away any
        // buffer narrower than one row without saying so.
        float edgeStop = pStep + buf
        bool atMarket = entryStyle == 'Market (enter now)'

        if kind == 'Rotation'
            if atMarket
                // Take it where price is, and be wrong at the edge of value.
                entry := px
                sl := stopMode == 'ATR' ? (isLong ? entry - atr * slATRMult : entry + atr * slATRMult) : stopMode == 'Profile Extreme' ? (isLong ? pLo - buf : pHi + buf) : (isLong ? pVal - edgeStop : pVah + edgeStop)
            else
                entry := isLong ? pVal : pVah
                sl := stopMode == 'ATR' ? (isLong ? entry - atr * slATRMult : entry + atr * slATRMult) : stopMode == 'Value Edge' ? (isLong ? entry - edgeStop : entry + edgeStop) : (isLong ? pLo - buf : pHi + buf)
        else
            if atMarket
                float brk = isLong ? (px > pHi ? pHi : pVah) : (px < pLo ? pLo : pVal)
                entry := px
                sl := stopMode == 'ATR' ? (isLong ? entry - atr * slATRMult : entry + atr * slATRMult) : stopMode == 'Profile Extreme' ? (isLong ? pLo - buf : pHi + buf) : (isLong ? brk - edgeStop : brk + edgeStop)
            else
                entry := isLong ? (px > pHi ? pHi : pVah) : (px < pLo ? pLo : pVal)
                sl := stopMode == 'ATR' ? (isLong ? entry - atr * slATRMult : entry + atr * slATRMult) : stopMode == 'Value Edge' ? (isLong ? pVah - buf : pVal + buf) : (isLong ? pVal - buf : pVah + buf)

        entry := rt(entry)
        sl := rt(sl)
        float minRisk = math.max(pStep, syminfo.mintick)
        bool wrongSide = isLong ? sl >= entry : sl <= entry
        if wrongSide or math.abs(entry - sl) < minRisk
            sl := rt(isLong ? entry - minRisk : entry + minRisk)
        float risk = math.abs(entry - sl)

        float tp1 = na
        float tp2 = na
        if tpMode == 'R Multiple'
            tp1 := isLong ? entry + risk * rr1 : entry - risk * rr1
            tp2 := isLong ? entry + risk * rr2 : entry - risk * rr2
        else
            if kind == 'Rotation'
                tp1 := pPoc
                tp2 := isLong ? pVah : pVal
            else
                tp1 := isLong ? entry + (pVah - pVal) : entry - (pVah - pVal)
                tp2 := isLong ? entry + (pHi - pLo) : entry - (pHi - pLo)
            if (isLong and tp1 <= entry) or (not isLong and tp1 >= entry)
                tp1 := isLong ? entry + risk * rr1 : entry - risk * rr1
            if (isLong and tp2 <= tp1) or (not isLong and tp2 >= tp1)
                tp2 := isLong ? entry + risk * rr2 : entry - risk * rr2
        tp1 := rt(tp1)
        tp2 := rt(tp2)

        // The same invalidation the indicator uses. Price through the stop or
        // past the far target means the idea is spent, not pending.
        bool outside = atMarket and kind == 'Rotation' and (px < pVal or px > pVah)
        bool dead = outside or (isLong and px <= sl) or (not isLong and px >= sl) or (isLong and px >= tp2) or (not isLong and px <= tp2)

        if not dead
            planEntry := entry
            planStop := sl
            planTp1 := tp1
            planTp2 := tp2
            planLong := isLong
            planValid := true

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------
var int tradesThisPeriod = 0
if newPeriod
    tradesThisPeriod := 0

bool inWindow = not useSession or not na(time(timeframe.period, sessionStr))
bool flat = strategy.position_size == 0

float riskPts = math.abs(planEntry - planStop)
float perUnit = riskPts * syminfo.pointvalue
int qty = perUnit > 0 ? int(math.floor(riskDollars / perUnit)) : 0
qty := math.max(0, math.min(qty, maxContracts))

bool armed = planValid and inWindow and flat and qty > 0 and tradesThisPeriod < maxTrades

if armed
    // A market plan goes in as a market order. Resting it as a limit at the
    // current price would only fill if price came back to it, which is the
    // behaviour the market style exists to avoid.
    bool mkt = entryStyle == 'Market (enter now)'
    if planLong
        if mkt
            strategy.entry('L', strategy.long, qty=qty)
        else if planEntry < close
            strategy.entry('L', strategy.long, qty=qty, limit=planEntry)
        else
            strategy.entry('L', strategy.long, qty=qty, stop=planEntry)
        strategy.cancel('S')
    else
        if mkt
            strategy.entry('S', strategy.short, qty=qty)
        else if planEntry > close
            strategy.entry('S', strategy.short, qty=qty, limit=planEntry)
        else
            strategy.entry('S', strategy.short, qty=qty, stop=planEntry)
        strategy.cancel('L')
else
    strategy.cancel('L')
    strategy.cancel('S')

// Freeze the bracket at the fill, so a later change of plan cannot move the
// stop or targets of a position that is already open.
var float actStop = na
var float actTp1 = na
var float actTp2 = na

var bool tookTp1 = false

bool justOpened = strategy.position_size != 0 and strategy.position_size[1] == 0
if justOpened
    actStop := planStop
    actTp1 := planTp1
    actTp2 := planTp2
    tookTp1 := false
    tradesThisPeriod += 1

// strategy.exit does not remember that an id has already filled. Calling X1
// again after the scale-out opens a second one against what is left, so the
// runner is shaved at TP1 on every bar it survives. Reaching the price is the
// fill. The entry bar is excluded because the bracket is only placed at the
// close of it, so nothing can fill against TP1 until the bar after.
bool tp1Reached = strategy.position_size > 0 ? high >= actTp1 : strategy.position_size < 0 ? low <= actTp1 : false
if not justOpened and not na(actTp1) and tp1Reached
    tookTp1 := true

if strategy.position_size != 0 and not na(actStop)
    if tp1Pct >= 100
        strategy.exit('X1', stop=actStop, limit=actTp1)
    else
        if tp1Pct > 0 and not tookTp1
            strategy.exit('X1', qty_percent=tp1Pct, stop=actStop, limit=actTp1)
        strategy.exit('X2', stop=actStop, limit=actTp2)

if newPeriod and flatAtEnd and strategy.position_size != 0
    strategy.close_all(comment='roll')

// ----------------------------------------------------------------------------
// Levels, so the fills can be checked against what the plan said
// ----------------------------------------------------------------------------
plot(showLevels and ready ? pPoc : na, 'POC', color=#ffb300, style=plot.style_linebr, linewidth=2)
plot(showLevels and ready ? pVah : na, 'VAH', color=#42a5f5, style=plot.style_linebr)
plot(showLevels and ready ? pVal : na, 'VAL', color=#42a5f5, style=plot.style_linebr)
plot(showLevels and ready ? pHi : na, 'Range High', color=color.new(#9e9e9e, 40), style=plot.style_linebr)
plot(showLevels and ready ? pLo : na, 'Range Low', color=color.new(#9e9e9e, 40), style=plot.style_linebr)
