//@version=6
// SaintTrades Pulse
//
// A momentum indicator built to answer four things at once: which way the
// market is leaning, whether it is worth trading right now, where to get in,
// and what to do with the trade once you are in it.
//
// Trend comes from two EMAs on the chart and one on a higher timeframe. Entries
// are pullback continuations - price has to come back to the fast EMA and then
// push off it, so nothing fires at the top of an extended run. A chop filter
// holds signals back when there is no trend to continue, and an optional
// reversal engine takes a swept high or low that closes straight back inside.
//
// Every signal carries a stop taken from structure and three targets set in R,
// and the trade is then tracked bar by bar: targets hit, stop moved to
// breakeven, result in R. The dashboard says the same thing in words.
//
// Candle Range Theory is the other engine in here. A completed higher timeframe
// candle is the range. The next one sweeps one end of it and closes back inside,
// which is the manipulation. The one after that is where you trade, back across
// the range, and the range itself gives you the targets: the midpoint first, the
// far end second. No invented R multiples - the levels come from the candle.
//
// Any symbol, any timeframe. The higher timeframe follows the chart unless you
// pin it.
indicator('SaintTrades Pulse', shorttitle='ST Pulse', overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ----------------------------------------------------------------------------
// Inputs
// ----------------------------------------------------------------------------
grpTrend = 'Trend'
fastLen = input.int(9, title='Fast EMA', minval=2, group=grpTrend)
slowLen = input.int(21, title='Slow EMA', minval=3, group=grpTrend)
htfAuto = input.bool(true, title='Higher Timeframe Follows Chart', group=grpTrend, tooltip='On a 1m chart the higher timeframe is 5m, on 5m it is 15m, and so on up. Turn this off to pin one.')
htfPin = input.timeframe('60', title='Higher Timeframe', group=grpTrend)
htfLen = input.int(50, title='HTF EMA', minval=5, group=grpTrend)

grpCrt = 'Candle Range Theory'
useCrt = input.bool(true, title='CRT Signals', group=grpCrt, tooltip='A completed higher timeframe candle is the range. The next sweeps one end and closes back inside it. You trade the one after that, back across the range.')
crtAuto = input.bool(true, title='CRT Timeframe Follows Chart', group=grpCrt, tooltip='1m takes its range from 15m, 5m from 1h, 15m from 4h, 1h from the day. That is the alignment CRT asks for.')
crtPin = input.timeframe('60', title='CRT Timeframe', group=grpCrt)
crtCloseIn = input.bool(true, title='Sweep Must Close Back Inside', group=grpCrt, tooltip='A sweep that closes back inside the range is the high odds version. One that closes outside leaves the range intact but the reversal is a worse bet, and this drops it.')
crtT1 = input.bool(true, title='First Target At The Midpoint', group=grpCrt, tooltip='The range midpoint, then the far end. Both come from the candle rather than from an R multiple.')
crtMinR = input.float(1.0, title='Minimum R To The Far End', minval=0, step=0.25, group=grpCrt)

grpFilter = 'Filters'
useKz = input.bool(false, title='Only In Killzone Hours', group=grpFilter, tooltip='CRT says the purge happens at particular hours. These are New York hours and the default set is the one in the notes.')
kzHours = input.string('1,3,6,8,9,11', title='Killzone Hours (NY)', group=grpFilter)
drLen = input.int(60, title='Dealing Range (bars)', minval=10, maxval=300, group=grpFilter, tooltip='The swing range that premium and discount are measured against.')
profLen = input.int(20, title='Profile Window (bars)', minval=5, maxval=100, group=grpFilter)
usePd = input.bool(true, title='Premium / Discount Filter', group=grpFilter, tooltip='Longs only in the lower half of the dealing range, shorts only in the upper half. Buying premium is how a good setup becomes a bad price.')
useProfile = input.bool(true, title='Profile Filter', group=grpFilter, tooltip='Only expansion and reversal profiles are traded. Ranging, manipulation and retracement are stood out, which is the filter the notes lead with.')

grpSig = 'Signals'
armLen = input.int(12, title='Pullback Window (bars)', minval=2, maxval=60, group=grpSig, tooltip='How long a pullback stays live. Price has to touch the fast EMA and then push off it inside this many bars, or the setup is dropped.')
allowRev = input.bool(true, title='Reversal Trades', group=grpSig, tooltip='Takes a sweep of a recent high or low that closes straight back inside. Off means continuation only.')
swpLen = input.int(20, title='Sweep Lookback (bars)', minval=5, maxval=100, group=grpSig)
minQual = input.int(55, title='Minimum Quality', minval=0, maxval=100, group=grpSig, tooltip='Signals scoring under this are not taken. 75 and up reads as an A, 55 to 74 a B.')
oneAtATime = input.bool(true, title='One Trade at a Time', group=grpSig, tooltip='On, nothing new prints until the trade on the chart is done. Off, signals keep coming and the tracker follows the newest one.')

grpChop = 'Chop Filter'
useChop = input.bool(true, title='Hold Signals in Chop', group=grpChop)
adxLen = input.int(14, title='ADX Length', minval=2, group=grpChop)
adxMin = input.float(18, title='Trend Threshold', minval=5, maxval=50, step=0.5, group=grpChop, tooltip='ADX under this reads as chop.')
erLen = input.int(14, title='Efficiency Length', minval=3, group=grpChop)
erMin = input.float(0.28, title='Minimum Efficiency', minval=0, maxval=1, step=0.01, group=grpChop, tooltip='How much of the distance price travelled ended up as progress. Low means it is going nowhere in a hurry.')

grpZone = 'Supply & Demand'
showZones = input.bool(true, title='Show Zones', group=grpZone)
pivLen = input.int(5, title='Pivot Length', minval=2, maxval=25, group=grpZone)
maxZones = input.int(6, title='Zones Per Side', minval=1, maxval=15, group=grpZone)
htfZones = input.bool(true, title='Higher Timeframe Zones', group=grpZone, tooltip='Adds a zone at each swing on the higher timeframe, drawn thicker and marked HTF.')

grpTrade = 'Trade'
structLen = input.int(10, title='Stop Structure (bars)', minval=3, maxval=60, group=grpTrade, tooltip='The stop goes beyond the low or high of this many bars, plus a buffer.')
stopBuf = input.float(0.35, title='Stop Buffer (ATR)', minval=0, maxval=3, step=0.05, group=grpTrade)
r1 = input.float(1.0, title='TP1 (R)', minval=0.25, step=0.25, group=grpTrade)
r2 = input.float(2.0, title='TP2 (R)', minval=0.5, step=0.25, group=grpTrade)
r3 = input.float(3.0, title='TP3 (R)', minval=0.75, step=0.25, group=grpTrade)
beAtTp1 = input.bool(true, title='Stop to Breakeven at TP1', group=grpTrade)
maxRiskAtr = input.float(2.5, title='Maximum Risk (ATR)', minval=0.5, maxval=10, step=0.1, group=grpTrade, tooltip='A signal whose stop sits further away than this is skipped. A wide stop is a bad price, not a bigger edge.')

grpDisp = 'Display'
mode = input.string('Full', title='Mode', options=['Full', 'Trade Only', 'Minimal'], group=grpDisp, tooltip='Full draws the EMAs, the zones and the trade. Trade Only drops the zones and the EMAs. Minimal is signal markers and alerts, nothing else on the chart.')
showDash = input.bool(true, title='Dashboard', group=grpDisp)
dashPos = input.string('Top Right', title='Dashboard Position', options=['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left', 'Middle Right'], group=grpDisp)
colUp = input.color(#26a69a, title='Up', inline='c', group=grpDisp)
colDn = input.color(#ef5350, title='Down', inline='c', group=grpDisp)
colFlat = input.color(#787b86, title='Flat', inline='c', group=grpDisp)

bool drawAll = mode == 'Full'
bool drawTrade = mode != 'Minimal'

fmt(float p) => str.tostring(p, format.mintick)
tick(float p) => math.round(p / syminfo.mintick) * syminfo.mintick

// ----------------------------------------------------------------------------
// Trend
//
// Two EMAs say what this chart is doing, one EMA on a higher timeframe says
// what it is doing inside. A signal with both behind it is worth more than one
// fighting the timeframe above.
// ----------------------------------------------------------------------------
// The step up, capped. CRT puts key levels twelve to twenty times above the
// chart you enter on, and on 1m and 5m that is what works. On 15m it does not:
// a 4h range puts its far end further than a session can reach, and 15m measured
// at 0.53 profit factor against a 4h range and 2.48 against a 1h one. So the
// ladder tops out where the far end is still reachable rather than where the
// ratio says it should.
int chartSec = timeframe.in_seconds(timeframe.period)
string htfAutoTf = chartSec <= 60 ? '15' : chartSec <= 900 ? '60' : chartSec <= 3600 ? '240' : chartSec <= 14400 ? 'D' : 'W'
string htf = htfAuto ? htfAutoTf : htfPin
string crtTf = crtAuto ? htfAutoTf : crtPin

// Everything pulled from the higher timeframe is taken one bar back, so a bar
// that is still forming up there cannot change what is already on the chart.
[htfEma, htfEmaP, htfC, htfPh, htfPl, htfAtr] = request.security(syminfo.tickerid, htf, [ta.ema(close, htfLen)[1], ta.ema(close, htfLen)[2], close[1], ta.pivothigh(pivLen, pivLen)[1], ta.pivotlow(pivLen, pivLen)[1], ta.atr(14)[1]], lookahead=barmerge.lookahead_off)

float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)
float atr = ta.atr(14)
float rsi = ta.rsi(close, 14)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
float volAvg = ta.sma(volume, 20)

bool htfUp = not na(htfEma) and htfC > htfEma and htfEma >= htfEmaP
bool htfDn = not na(htfEma) and htfC < htfEma and htfEma <= htfEmaP
bool locUp = emaFast > emaSlow and close > emaSlow
bool locDn = emaFast < emaSlow and close < emaSlow
int bias = locUp ? 1 : locDn ? -1 : 0

// ----------------------------------------------------------------------------
// Chop
//
// ADX says whether there is a trend at all. The efficiency ratio says how much
// of the distance price covered was progress rather than backing and filling.
// Both weak is chop, and in chop a continuation has nothing to continue.
// ----------------------------------------------------------------------------
float move = math.abs(close - close[erLen])
float path = math.sum(math.abs(close - close[1]), erLen)
float er = path > 0 ? move / path : 0.0

bool weakAdx = adx < adxMin
bool weakEr = er < erMin
bool chop = weakAdx or weakEr
string cond = weakAdx and weakEr ? 'CHOP' : chop ? 'SOFT' : adx > 30 ? 'STRONG TREND' : 'TRENDING'

// ----------------------------------------------------------------------------
// Structure
//
// Confirmed pivots, kept two deep a side, so the swings can be read as higher
// highs and higher lows rather than eyeballed.
// ----------------------------------------------------------------------------
float ph = ta.pivothigh(pivLen, pivLen)
float pl = ta.pivotlow(pivLen, pivLen)

var float lastPh = na
var float prevPh = na
var float lastPl = na
var float prevPl = na

if not na(ph)
    prevPh := lastPh
    lastPh := ph
if not na(pl)
    prevPl := lastPl
    lastPl := pl

bool hh = not na(lastPh) and not na(prevPh) and lastPh > prevPh
bool lh = not na(lastPh) and not na(prevPh) and lastPh < prevPh
bool hl = not na(lastPl) and not na(prevPl) and lastPl > prevPl
bool ll = not na(lastPl) and not na(prevPl) and lastPl < prevPl

string structTxt = hh and hl ? 'HH / HL' : lh and ll ? 'LH / LL' : hh and ll ? 'EXPANDING' : lh and hl ? 'COMPRESSING' : 'MIXED'
int structDir = hh and hl ? 1 : lh and ll ? -1 : 0

// ----------------------------------------------------------------------------
// Supply and demand
//
// A zone is built at each confirmed swing, from the extreme back to the body of
// the bar that made it. It lives until price closes through it, which is the
// only news a zone ever gives you. Higher timeframe swings get their own,
// thicker and marked, because they are the ones that stop a move.
// ----------------------------------------------------------------------------
var array<box> dZones = array.new<box>()
var array<box> sZones = array.new<box>()
var array<bool> dHtf = array.new<bool>()
var array<bool> sHtf = array.new<bool>()

zoneEdge(bool dem, bool htfZ) => color.new(dem ? colUp : colDn, showZones and drawAll ? (htfZ ? 25 : 45) : 100)
zoneFill(bool dem, bool htfZ) => color.new(dem ? colUp : colDn, showZones and drawAll ? (htfZ ? 82 : 90) : 100)

addZone(array<box> arr, array<bool> flags, float top, float bot, int left, bool dem, bool htfZ) =>
    box b = box.new(left, top, bar_index + 3, bot, xloc=xloc.bar_index, border_color=zoneEdge(dem, htfZ), border_width=htfZ ? 2 : 1, bgcolor=zoneFill(dem, htfZ), text=htfZ ? 'HTF' : '', text_color=color.new(dem ? colUp : colDn, showZones and drawAll ? 25 : 100), text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_center)
    array.push(arr, b)
    array.push(flags, htfZ)
    if array.size(arr) > maxZones
        box old = array.shift(arr)
        array.shift(flags)
        box.delete(old)

if not na(pl)
    float bot = low[pivLen]
    float top = math.max(math.max(open[pivLen], close[pivLen]), bot + atr * 0.2)
    addZone(dZones, dHtf, top, bot, bar_index - pivLen, true, false)

if not na(ph)
    float top = high[pivLen]
    float bot = math.min(math.min(open[pivLen], close[pivLen]), top - atr * 0.2)
    addZone(sZones, sHtf, top, bot, bar_index - pivLen, false, false)

if htfZones and not na(htfPl) and (na(htfPl[1]) or htfPl != htfPl[1])
    addZone(dZones, dHtf, htfPl + nz(htfAtr, atr) * 0.5, htfPl, bar_index - 1, true, true)

if htfZones and not na(htfPh) and (na(htfPh[1]) or htfPh != htfPh[1])
    addZone(sZones, sHtf, htfPh, htfPh - nz(htfAtr, atr) * 0.5, bar_index - 1, false, true)

// Walked from the back so a removal does not shuffle the ones not yet checked.
keepZones(array<box> arr, array<bool> flags, bool dem) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            box b = array.get(arr, i)
            bool hz = array.get(flags, i)
            if dem ? close < box.get_bottom(b) : close > box.get_top(b)
                array.remove(arr, i)
                array.remove(flags, i)
                box.delete(b)
            else
                box.set_right(b, bar_index + 3)
                box.set_border_color(b, zoneEdge(dem, hz))
                box.set_bgcolor(b, zoneFill(dem, hz))
                box.set_text_color(b, color.new(dem ? colUp : colDn, showZones and drawAll ? 25 : 100))

keepZones(dZones, dHtf, true)
keepZones(sZones, sHtf, false)

inZone(array<box> arr, float px, float tol) =>
    bool hit = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            box b = array.get(arr, i)
            if px >= box.get_bottom(b) - tol and px <= box.get_top(b) + tol
                hit := true
    hit

bool atDemand = inZone(dZones, low, atr * 0.15)
bool atSupply = inZone(sZones, high, atr * 0.15)

// ----------------------------------------------------------------------------
// Candle Range Theory
//
// Three candles on the timeframe above. The first is the range and nothing about
// it needs to be a consolidation - the whole candle is the framework. The second
// sweeps one end of that range and, in the version worth taking, closes back
// inside it. The third is where the move goes, and the range it came from says
// where to: the midpoint, then the far end.
//
// The candles are accumulated here rather than requested, so nothing is read
// from a bar that has not finished forming.
// ----------------------------------------------------------------------------
bool newCrt = timeframe.change(crtTf)

var float curH = na
var float curL = na
var float c1H = na
var float c1L = na
var float c2H = na
var float c2L = na
var float c2C = na

if newCrt
    c1H := c2H
    c1L := c2L
    c2H := curH
    c2L := curL
    c2C := close[1]
    curH := high
    curL := low
else
    curH := na(curH) ? high : math.max(curH, high)
    curL := na(curL) ? low : math.min(curL, low)

bool crtReady = not na(c1H) and not na(c1L) and not na(c2H) and not na(c2L) and c1H > c1L

// The sweep. Below the range low and back inside is a bullish candle range; the
// mirror is bearish. Closing back outside leaves the range intact but is the
// weaker of the two, so it is gated rather than scored down.
bool sweptLow = crtReady and c2L < c1L
bool sweptHigh = crtReady and c2H > c1H
bool closedIn = crtReady and c2C > c1L and c2C < c1H
bool crtBull = sweptLow and not sweptHigh and (not crtCloseIn or c2C > c1L)
bool crtBear = sweptHigh and not sweptLow and (not crtCloseIn or c2C < c1H)

float crtMid = crtReady ? (c1H + c1L) / 2.0 : na
float crtEql = crtMid

// One trade per range. The third candle is the whole opportunity.
var bool crtUsed = false
if newCrt
    crtUsed := false

// ----------------------------------------------------------------------------
// Premium and discount
//
// The dealing range, split at the middle. A long belongs in the lower half and a
// short in the upper half, whatever else agrees.
// ----------------------------------------------------------------------------
float drHi = ta.highest(high, drLen)
float drLo = ta.lowest(low, drLen)
float drEql = (drHi + drLo) / 2.0
bool inDiscount = close < drEql
bool inPremium = close > drEql

// ----------------------------------------------------------------------------
// Market profile
//
// Range, expansion, retracement, manipulation, reversal. The notes only let you
// trade the expansion and the reversal, and stand you out of the other three,
// which is the single biggest filter in them.
// ----------------------------------------------------------------------------
float rngHi = ta.highest(high, profLen)[1]
float rngLo = ta.lowest(low, profLen)[1]
bool brokeUp = close > rngHi
bool brokeDn = close < rngLo
bool sweptBack = (high > rngHi and close < rngHi) or (low < rngLo and close > rngLo)

string profile = sweptBack ? 'MANIPULATION' : (brokeUp or brokeDn) and not chop ? 'EXPANSION' : chop ? 'RANGE' : structDir != 0 and ((structDir == 1 and close < close[3]) or (structDir == -1 and close > close[3])) ? 'RETRACEMENT' : (crtBull or crtBear) ? 'REVERSAL' : 'RANGE'
bool profileOk = not useProfile or profile == 'EXPANSION' or profile == 'REVERSAL' or profile == 'MANIPULATION'

// ----------------------------------------------------------------------------
// Killzone
//
// CRT is a time idea before it is a price idea. The purge is expected in
// particular hours and everything outside them is a lower grade of the same
// pattern.
// ----------------------------------------------------------------------------
inKillzone() =>
    bool hit = false
    if not useKz
        hit := true
    else
        int h = hour(time, 'America/New_York')
        array<string> parts = str.split(kzHours, ',')
        if array.size(parts) > 0
            for i = 0 to array.size(parts) - 1
                if int(math.round(str.tonumber(str.replace_all(array.get(parts, i), ' ', '')))) == h
                    hit := true
    hit

bool kzOk = inKillzone()

// ----------------------------------------------------------------------------
// Signal engine
//
// A pullback arms the setup: in an uptrend price has to trade down into the
// fast EMA. It stays armed for a set number of bars, and it fires when price
// takes out the previous bar and closes back above the EMA. That way the entry
// is off a pullback, not into the top of a run.
//
// The reversal is the other trade this market gives: a push through a recent
// extreme that closes straight back inside it, which is a failed break.
// ----------------------------------------------------------------------------
var bool armLong = false
var bool armShort = false
var int armLongBar = 0
var int armShortBar = 0

if locUp and low <= emaFast
    armLong := true
    armLongBar := bar_index
if locDn and high >= emaFast
    armShort := true
    armShortBar := bar_index
if not locUp or bar_index - armLongBar > armLen
    armLong := false
if not locDn or bar_index - armShortBar > armLen
    armShort := false

bool trigLong = armLong and close > high[1] and close > emaFast and close > open and rsi > 50
bool trigShort = armShort and close < low[1] and close < emaFast and close < open and rsi < 50

if trigLong
    armLong := false
if trigShort
    armShort := false

float swpHi = ta.highest(high, swpLen)[1]
float swpLo = ta.lowest(low, swpLen)[1]
bool revLong = allowRev and low < swpLo and close > swpLo and close > open and rsi < 45
bool revShort = allowRev and high > swpHi and close < swpHi and close < open and rsi > 55

// The third candle, confirmed. Conformational CRT is the version the notes tell
// you to trade: never the sweep itself, only the candle after it, and only once
// it has shown its hand.
bool crtSigL = useCrt and crtBull and not crtUsed and close > high[1] and close > open
bool crtSigS = useCrt and crtBear and not crtUsed and close < low[1] and close < open

bool blocked = useChop and chop
bool pdOkL = not usePd or inDiscount
bool pdOkS = not usePd or inPremium
bool rawLong = (((trigLong or revLong) and not blocked) or crtSigL) and profileOk and kzOk and pdOkL
bool rawShort = (((trigShort or revShort) and not blocked) or crtSigS) and profileOk and kzOk and pdOkS
bool isCrtL = crtSigL
bool isCrtS = crtSigS
bool isRevL = revLong and not trigLong and not crtSigL
bool isRevS = revShort and not trigShort and not crtSigS

// Quality is what separates a signal you size up from one you leave alone.
// Alignment with the timeframe above carries the most, then how much trend
// there is to work with, then momentum, whether the entry is off a zone, and
// whether anyone traded it.
score(int dir, bool rev, bool crt) =>
    float s = crt ? (closedIn ? 30.0 : 18.0) : rev ? 15.0 : (dir == 1 ? htfUp : htfDn) ? 30.0 : (dir == 1 ? htfDn : htfUp) ? 0.0 : 15.0
    s += math.min(25.0, adx / 40.0 * 25.0)
    float m = dir == 1 ? rsi - 50.0 : 50.0 - rsi
    s += math.min(20.0, math.max(0.0, m))
    s += (dir == 1 ? atDemand : atSupply) ? 15.0 : 0.0
    s += volume > volAvg ? 10.0 : 0.0
    s += structDir == dir ? 5.0 : 0.0
    s += crt and (dir == 1 ? inDiscount : inPremium) ? 8.0 : 0.0
    s += crt and kzOk and useKz ? 5.0 : 0.0
    math.max(0.0, math.min(100.0, s))

grade(float s) => s >= 75 ? 'A' : s >= 55 ? 'B' : s >= 35 ? 'C' : 'D'

float qLong = score(1, isRevL, isCrtL)
float qShort = score(-1, isRevS, isCrtS)

// The stop goes beyond recent structure, not a fixed distance, and a signal
// that needs too much room is not taken.
// A CRT trade takes its stop from the wick that did the sweeping and its targets
// from the range that was swept. Nothing here is an R multiple.
float crtStopL = crtReady ? tick(c2L - atr * stopBuf) : na
float crtStopS = crtReady ? tick(c2H + atr * stopBuf) : na
float crtFarL = c1H
float crtFarS = c1L

float loN = ta.lowest(low, structLen)
float hiN = ta.highest(high, structLen)
float stopLong = tick(math.min(loN, low) - atr * stopBuf)
float stopShort = tick(math.max(hiN, high) + atr * stopBuf)
float useStopL = isCrtL and not na(crtStopL) ? crtStopL : stopLong
float useStopS = isCrtS and not na(crtStopS) ? crtStopS : stopShort
bool riskOkL = close - useStopL > syminfo.mintick and close - useStopL <= atr * maxRiskAtr
bool riskOkS = useStopS - close > syminfo.mintick and useStopS - close <= atr * maxRiskAtr

// A range whose far end does not pay for the sweep is not worth the trade.
float crtRl = close - useStopL
float crtRs = useStopS - close
bool crtRokL = not isCrtL or (not na(crtFarL) and crtRl > 0 and (crtFarL - close) / crtRl >= crtMinR)
bool crtRokS = not isCrtS or (not na(crtFarS) and crtRs > 0 and (close - crtFarS) / crtRs >= crtMinR)

// ----------------------------------------------------------------------------
// Trade
// ----------------------------------------------------------------------------
var int tDir = 0
var float tEntry = na
var float tStop = na
var float tRisk = na
var float tT1 = na
var float tT2 = na
var float tT3 = na
var bool tB1 = false
var bool tB2 = false
var bool tB3 = false
var bool tBe = false
var int tBar = 0
var string tKind = ''
var string tGrade = ''
var float lastR = na
var int wins = 0
var int losses = 0
var string lastSig = 'none yet'

bool canOpen = not oneAtATime or tDir == 0
bool longSig = rawLong and canOpen and riskOkL and crtRokL and qLong >= minQual
bool shortSig = rawShort and canOpen and riskOkS and crtRokS and qShort >= minQual

// Management runs on the bars after entry. The entry bar itself is left alone,
// because a target and a stop both touched on the bar you got filled is not a
// result, it is noise.
bool evStop = false
bool evT1 = false
bool evT2 = false
bool evT3 = false
bool evBe = false

if tDir != 0 and bar_index > tBar
    if tDir == 1 ? low <= tStop : high >= tStop
        evStop := true
    else
        if not tB1 and (tDir == 1 ? high >= tT1 : low <= tT1)
            tB1 := true
            evT1 := true
            if beAtTp1 and not tBe
                tStop := tEntry
                tBe := true
                evBe := true
        if not tB2 and (tDir == 1 ? high >= tT2 : low <= tT2)
            tB2 := true
            evT2 := true
        if not tB3 and (tDir == 1 ? high >= tT3 : low <= tT3)
            tB3 := true
            evT3 := true

if evStop or evT3
    lastR := evT3 ? r3 : tBe ? 0.0 : -1.0
    if lastR > 0
        wins += 1
    else if lastR < 0
        losses += 1
    tDir := 0

if longSig or shortSig
    tDir := longSig ? 1 : -1
    tEntry := tick(close)
    bool crtTrade = longSig ? isCrtL : isCrtS
    tStop := longSig ? useStopL : useStopS
    tRisk := math.abs(tEntry - tStop)
    if crtTrade
        // The range supplies the levels. Midpoint, far end, and a runner half a
        // range beyond it for the third.
        float far = longSig ? crtFarL : crtFarS
        float mid = crtMid
        float span = math.abs(c1H - c1L)
        tT1 := tick(crtT1 and not na(mid) ? mid : far)
        tT2 := tick(far)
        tT3 := tick(far + tDir * span * 0.5)
        // A midpoint already behind price is not a target.
        if (tDir == 1 and tT1 <= tEntry) or (tDir == -1 and tT1 >= tEntry)
            tT1 := tick(far)
        crtUsed := true
    else
        tT1 := tick(tEntry + tDir * tRisk * r1)
        tT2 := tick(tEntry + tDir * tRisk * r2)
        tT3 := tick(tEntry + tDir * tRisk * r3)
    tB1 := false
    tB2 := false
    tB3 := false
    tBe := false
    tBar := bar_index
    tKind := (longSig ? isCrtL : isCrtS) ? 'CRT' : (longSig ? isRevL : isRevS) ? 'reversal' : 'continuation'
    tGrade := grade(longSig ? qLong : qShort)
    lastSig := (longSig ? 'BUY ' : 'SELL ') + tGrade + '  ' + str.tostring(longSig ? qLong : qShort, '#') + '  ' + tKind

// ----------------------------------------------------------------------------
// The trade on the chart
//
// Five lines and their prices, held out to the right for as long as the trade
// is open and left where they were when it closes.
// ----------------------------------------------------------------------------
var line lnE = na
var line lnS = na
var line lnT1 = na
var line lnT2 = na
var line lnT3 = na
var label lbE = na
var label lbS = na
var label lb1 = na
var label lb2 = na
var label lb3 = na

if (longSig or shortSig) and drawTrade
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT1)
    line.delete(lnT2)
    line.delete(lnT3)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lb1)
    label.delete(lb2)
    label.delete(lb3)
    color cd = tDir == 1 ? colUp : colDn
    lnE := line.new(bar_index, tEntry, bar_index + 1, tEntry, xloc=xloc.bar_index, color=#42a5f5, width=3)
    lnS := line.new(bar_index, tStop, bar_index + 1, tStop, xloc=xloc.bar_index, color=colDn, width=1, style=line.style_dashed)
    lnT1 := line.new(bar_index, tT1, bar_index + 1, tT1, xloc=xloc.bar_index, color=colUp, width=1)
    lnT2 := line.new(bar_index, tT2, bar_index + 1, tT2, xloc=xloc.bar_index, color=color.new(colUp, 25), width=1)
    lnT3 := line.new(bar_index, tT3, bar_index + 1, tT3, xloc=xloc.bar_index, color=color.new(colUp, 45), width=1)
    lbE := label.new(bar_index + 1, tEntry, (tDir == 1 ? ' BUY ' : ' SELL ') + fmt(tEntry) + '  ' + tGrade, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=cd, size=size.normal)
    lbS := label.new(bar_index + 1, tStop, ' SL ' + fmt(tStop), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=colDn, size=size.small)
    lb1 := label.new(bar_index + 1, tT1, ' TP1 ' + fmt(tT1), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=colUp, size=size.small)
    lb2 := label.new(bar_index + 1, tT2, ' TP2 ' + fmt(tT2), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=colUp, size=size.small)
    lb3 := label.new(bar_index + 1, tT3, ' TP3 ' + fmt(tT3), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=colUp, size=size.small)

if (tDir != 0 or evStop or evT3) and drawTrade and not na(lnE)
    int x = bar_index + 1
    line.set_x2(lnE, x)
    line.set_x2(lnS, x)
    line.set_x2(lnT1, x)
    line.set_x2(lnT2, x)
    line.set_x2(lnT3, x)
    line.set_y1(lnS, tStop)
    line.set_y2(lnS, tStop)
    label.set_x(lbE, x)
    label.set_x(lbS, x)
    label.set_x(lb1, x)
    label.set_x(lb2, x)
    label.set_x(lb3, x)
    label.set_y(lbS, tStop)
    label.set_text(lbS, (tBe ? ' BE ' : ' SL ') + fmt(tStop))
    label.set_text(lb1, (tB1 ? ' TP1 HIT ' : ' TP1 ') + fmt(tT1))
    label.set_text(lb2, (tB2 ? ' TP2 HIT ' : ' TP2 ') + fmt(tT2))
    label.set_text(lb3, (tB3 ? ' TP3 HIT ' : ' TP3 ') + fmt(tT3))
    if evStop or evT3
        label.set_text(lbE, label.get_text(lbE) + '  -  ' + str.tostring(lastR, '#.##') + 'R')

// The range itself, so the targets on the chart can be checked against the
// candle they came from.
plot(drawAll and crtReady and (crtBull or crtBear) ? c1H : na, title='CRT High', color=color.new(#ffb300, 30), style=plot.style_linebr, linewidth=1)
plot(drawAll and crtReady and (crtBull or crtBear) ? c1L : na, title='CRT Low', color=color.new(#ffb300, 30), style=plot.style_linebr, linewidth=1)
plot(drawAll and crtReady and (crtBull or crtBear) ? crtMid : na, title='CRT Mid', color=color.new(#ffb300, 55), style=plot.style_linebr, linewidth=1)

plot(drawAll ? emaFast : na, title='Fast EMA', color=color.new(#42a5f5, 20), linewidth=1)
plot(drawAll ? emaSlow : na, title='Slow EMA', color=color.new(colFlat, 20), linewidth=1)

plotshape(longSig, title='Buy', style=shape.triangleup, location=location.belowbar, color=colUp, size=size.small)
plotshape(shortSig, title='Sell', style=shape.triangledown, location=location.abovebar, color=colDn, size=size.small)

barcolor(drawAll ? (blocked ? color.new(colFlat, 55) : na) : na, title='Chop')

// ----------------------------------------------------------------------------
// Dashboard
// ----------------------------------------------------------------------------
meter(float v, float cap) =>
    int n = int(math.round(math.min(1.0, math.max(0.0, v / cap)) * 10))
    str.repeat('=', n, '') + str.repeat('.', 10 - n, '')

var table dash = table.new(dashPos == 'Top Left' ? position.top_left : dashPos == 'Bottom Right' ? position.bottom_right : dashPos == 'Bottom Left' ? position.bottom_left : dashPos == 'Middle Right' ? position.middle_right : position.top_right, 2, 11, bgcolor=color.new(#131722, 12), frame_color=color.new(colFlat, 55), frame_width=1, border_color=color.new(colFlat, 80), border_width=1)

row(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color=color.new(colFlat, 15), text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)

if barstate.islast and showDash
    float openR = tDir == 0 or na(tRisk) or tRisk <= 0 ? na : (close - tEntry) / tRisk * tDir
    string manage = tDir == 0 ? (na(lastR) ? 'flat' : 'flat  -  last ' + str.tostring(lastR, '#.##') + 'R') : tB3 ? 'TP3 hit  -  done' : tB2 ? 'TP2 hit  -  running to TP3' : tB1 ? (tBe ? 'TP1 hit  -  stop at breakeven' : 'TP1 hit') : tBe ? 'stop at breakeven' : 'working to TP1'
    string tradeTxt = tDir == 0 ? 'FLAT' : (tDir == 1 ? 'LONG ' : 'SHORT ') + fmt(tEntry) + '  ' + str.tostring(openR, '#.##') + 'R'
    string crtTxt = not crtReady ? 'forming' : crtBull ? 'SWEPT LOW  ' + fmt(c1L) : crtBear ? 'SWEPT HIGH  ' + fmt(c1H) : 'intact  ' + fmt(c1L) + ' - ' + fmt(c1H)

    table.cell(dash, 0, 0, ' SAINTTRADES PULSE ', text_color=color.new(color.white, 0), text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#42a5f5, 60))
    table.cell(dash, 1, 0, syminfo.ticker + '  ' + timeframe.period, text_color=color.new(color.white, 20), text_size=size.small, text_halign=text.align_right, bgcolor=color.new(#42a5f5, 60))

    row(1, ' Bias', bias == 1 ? 'BULLISH' : bias == -1 ? 'BEARISH' : 'NEUTRAL', bias == 1 ? colUp : bias == -1 ? colDn : colFlat)
    row(2, ' ' + htf + ' Trend', htfUp ? 'UP' : htfDn ? 'DOWN' : 'FLAT', htfUp ? colUp : htfDn ? colDn : colFlat)
    row(3, ' Strength', meter(adx, 40) + '  ' + str.tostring(adx, '#'), adx >= 30 ? colUp : adx >= adxMin ? #ffb300 : colFlat)
    row(4, ' Condition', cond, chop ? #ffb300 : colUp)
    row(5, ' Profile', profile, profile == 'EXPANSION' or profile == 'REVERSAL' ? colUp : profile == 'MANIPULATION' ? #ffb300 : colFlat)
    row(6, ' ' + crtTf + ' Range', crtTxt, crtBull ? colUp : crtBear ? colDn : colFlat)
    row(7, ' Zone', na(drEql) ? '-' : inDiscount ? 'DISCOUNT' : 'PREMIUM', inDiscount ? colUp : colDn)
    row(8, ' Structure', structTxt, structDir == 1 ? colUp : structDir == -1 ? colDn : colFlat)
    row(9, ' Last Signal', lastSig, str.startswith(lastSig, 'BUY') ? colUp : str.startswith(lastSig, 'SELL') ? colDn : colFlat)
    row(10, ' Trade', tradeTxt + '   ' + manage, tDir == 1 ? colUp : tDir == -1 ? colDn : colFlat)

// ----------------------------------------------------------------------------
// Alerts
// ----------------------------------------------------------------------------
alertcondition(longSig, title='Buy', message='ST Pulse BUY - pullback entry with the trend')
alertcondition(shortSig, title='Sell', message='ST Pulse SELL - pullback entry with the trend')
alertcondition(evT1, title='TP1 Hit', message='ST Pulse TP1 hit')
alertcondition(evT2, title='TP2 Hit', message='ST Pulse TP2 hit')
alertcondition(evT3, title='TP3 Hit', message='ST Pulse TP3 hit - trade closed')
alertcondition(evStop, title='Stopped', message='ST Pulse stop hit')
alertcondition(longSig or shortSig, title='Any Signal', message='ST Pulse signal')
alertcondition(crtSigL, title='CRT Buy', message='ST Pulse CRT BUY - range low swept and reclaimed')
alertcondition(crtSigS, title='CRT Sell', message='ST Pulse CRT SELL - range high swept and reclaimed')

if longSig or shortSig
    alert('ST Pulse ' + (tDir == 1 ? 'BUY' : 'SELL') + ' ' + syminfo.ticker + ' ' + timeframe.period + ' @ ' + fmt(tEntry) + '  SL ' + fmt(tStop) + '  TP1 ' + fmt(tT1) + '  TP2 ' + fmt(tT2) + '  TP3 ' + fmt(tT3) + '  grade ' + tGrade + ' (' + tKind + ')', alert.freq_once_per_bar_close)
if evBe
    alert('ST Pulse TP1 hit on ' + syminfo.ticker + ' - stop moved to breakeven at ' + fmt(tStop), alert.freq_once_per_bar_close)
if evT2
    alert('ST Pulse TP2 hit on ' + syminfo.ticker + ' at ' + fmt(tT2), alert.freq_once_per_bar_close)
if evT3
    alert('ST Pulse TP3 hit on ' + syminfo.ticker + ' at ' + fmt(tT3) + ' - trade closed for ' + str.tostring(r3, '#.##') + 'R', alert.freq_once_per_bar_close)
if evStop
    alert('ST Pulse stop hit on ' + syminfo.ticker + ' at ' + fmt(tStop), alert.freq_once_per_bar_close)
