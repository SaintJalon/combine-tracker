//@version=6
// SaintTrades Volume Range
//
// A fixed range volume profile, and what to do about it.
//
// The profile is built from a block of N bars and then HELD for the next N,
// which is the part that matters. Rebuilding it every bar makes the value area
// chase price around: wherever price goes, the last N bars go with it, the area
// re-forms around the new price, and price is never outside it. Frozen, the
// levels stay where they were formed and price can actually leave them.
//
// It marks the POC and the value area, and when price leaves value, holds out,
// and closes back in, it gives an entry, a stop and a target. Any symbol, any
// timeframe, no sessions, nothing to set per instrument.
indicator('SaintTrades Volume Range', shorttitle='ST VR', overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=300, max_bars_back=1000)

// ----------------------------------------------------------------------------
// Inputs
// ----------------------------------------------------------------------------
lenBars = input.int(200, title='Range (bars)', minval=20, maxval=500, tooltip='Bars in a block. The profile is built from one block and held for the next, so the levels are fixed while price trades against them.')
rows = input.int(40, title='Rows', minval=10, maxval=120)
vaPct = input.float(70, title='Value Area %', minval=30, maxval=95, step=1)

grpSig = 'Signal'
confirmBars = input.int(2, title='Bars Outside First', minval=1, maxval=20, group=grpSig, tooltip='How long price must hold beyond the value area before a close back inside counts.')
planLen = input.int(30, title='Plan Lines (bars)', minval=5, maxval=200, group=grpSig)

grpDisp = 'Display'
showProfile = input.bool(true, title='Show Profile', group=grpDisp)
profWidth = input.int(60, title='Profile Width (bars)', minval=5, maxval=200, group=grpDisp)
colUp = input.color(color.new(#26a69a, 60), title='Up', inline='c1', group=grpDisp)
colDn = input.color(color.new(#ef5350, 60), title='Down', inline='c1', group=grpDisp)
colPoc = input.color(#ffb300, title='POC', inline='c2', group=grpDisp)
colVa = input.color(#42a5f5, title='Value', inline='c2', group=grpDisp)

fmt(float p) => str.tostring(p, format.mintick)

// ----------------------------------------------------------------------------
// The profile, built once a block and held
// ----------------------------------------------------------------------------
var float poc = na
var float vah = na
var float val = na
var float rHi = na
var float rLo = na
var float vaStep = na

var array<float> upVol = array.new<float>(0)
var array<float> dnVol = array.new<float>(0)
var float pGridLo = na
var float pStep = na
var int pRows = 0
var int pPoc = 0
var int pVaUp = 0
var int pVaDn = 0

bool roll = bar_index >= lenBars and bar_index % lenBars == 0

if roll
    float hi = high[1]
    float lo = low[1]
    for i = 1 to lenBars
        hi := math.max(hi, high[i])
        lo := math.min(lo, low[i])

    float step = (hi - lo) / rows
    step := step <= 0 ? syminfo.mintick : step

    array.clear(upVol)
    array.clear(dnVol)
    for r = 0 to rows - 1
        array.push(upVol, 0.0)
        array.push(dnVol, 0.0)

    // Each bar spreads across every row it spans. A bar is not all at its close.
    for i = 1 to lenBars
        float bh = high[i]
        float bl = low[i]
        if not na(bh) and not na(bl)
            float span = bh - bl
            float v = nz(volume[i], 1.0)
            v := v <= 0 ? 1.0 : v
            bool isUp = close[i] >= open[i]
            int r1 = math.max(0, math.min(rows - 1, int(math.floor((bl - lo) / step))))
            int r2 = math.max(0, math.min(rows - 1, int(math.floor((bh - lo) / step))))
            for r = r1 to r2
                float rBot = lo + r * step
                float overlap = math.min(bh, rBot + step) - math.max(bl, rBot)
                float share = span <= 0 ? 1.0 : math.max(overlap, 0) / span
                float add = v * share
                if isUp
                    array.set(upVol, r, array.get(upVol, r) + add)
                else
                    array.set(dnVol, r, array.get(dnVol, r) + add)

    float total = 0.0
    float maxRow = 0.0
    array<float> rowVol = array.new<float>(rows, 0.0)
    for r = 0 to rows - 1
        float t = array.get(upVol, r) + array.get(dnVol, r)
        array.set(rowVol, r, t)
        total += t
        maxRow := math.max(maxRow, t)

    // A tie goes to the row nearest the middle, not the lowest price.
    int pocIdx = 0
    float mid = (rows - 1) / 2.0
    float best = rows + 1.0
    for r = 0 to rows - 1
        if array.get(rowVol, r) >= maxRow
            float d = math.abs(r - mid)
            if d < best
                best := d
                pocIdx := r

    // Grown out from the POC two rows a side, the way a Market Profile does.
    int vaUp = pocIdx
    int vaDn = pocIdx
    float acc = array.get(rowVol, pocIdx)
    float target = total * vaPct / 100.0
    for _i = 0 to rows - 1
        if acc >= target
            break
        float sumUp = -1.0
        int upRows = 0
        if vaUp + 1 <= rows - 1
            sumUp := array.get(rowVol, vaUp + 1)
            upRows := 1
            if vaUp + 2 <= rows - 1
                sumUp += array.get(rowVol, vaUp + 2)
                upRows := 2
        float sumDn = -1.0
        int dnRows = 0
        if vaDn - 1 >= 0
            sumDn := array.get(rowVol, vaDn - 1)
            dnRows := 1
            if vaDn - 2 >= 0
                sumDn += array.get(rowVol, vaDn - 2)
                dnRows := 2
        if upRows == 0 and dnRows == 0
            break
        if sumUp >= sumDn
            vaUp += upRows
            acc += sumUp
        else
            vaDn -= dnRows
            acc += sumDn

    poc := math.round((lo + (pocIdx + 0.5) * step) / syminfo.mintick) * syminfo.mintick
    vah := math.min(math.round((lo + (vaUp + 1) * step) / syminfo.mintick) * syminfo.mintick, hi)
    val := math.max(math.round((lo + vaDn * step) / syminfo.mintick) * syminfo.mintick, lo)
    rHi := hi
    rLo := lo
    vaStep := step
    pGridLo := lo
    pStep := step
    pRows := rows
    pPoc := pocIdx
    pVaUp := vaUp
    pVaDn := vaDn

bool ready = not na(val) and not na(vah)

// ----------------------------------------------------------------------------
// Signal, entry, stop, target
//
// Price leaves value, holds out, closes back in. The stop goes beyond the
// extreme it reached while it was out - if price goes back through that, the
// move back in has failed. The target is the POC, which is what price is
// coming back for.
// ----------------------------------------------------------------------------
var int barsBelow = 0
var int barsAbove = 0
var float outLow = na
var float outHigh = na

bool buy = false
bool sell = false
float sigEntry = na
float sigStop = na
float sigTgt = na

if ready
    if close < val
        barsBelow += 1
        barsAbove := 0
        outLow := na(outLow) ? low : math.min(outLow, low)
        outHigh := na
    else if close > vah
        barsAbove += 1
        barsBelow := 0
        outHigh := na(outHigh) ? high : math.max(outHigh, high)
        outLow := na
    else
        if barsBelow >= confirmBars and not na(outLow)
            buy := true
            sigEntry := close
            sigStop := math.round((outLow - vaStep) / syminfo.mintick) * syminfo.mintick
            sigTgt := poc
        if barsAbove >= confirmBars and not na(outHigh)
            sell := true
            sigEntry := close
            sigStop := math.round((outHigh + vaStep) / syminfo.mintick) * syminfo.mintick
            sigTgt := poc
        barsBelow := 0
        barsAbove := 0
        outLow := na
        outHigh := na

// A target the wrong side of entry is not a trade.
if buy and (na(sigTgt) or sigTgt <= sigEntry or sigStop >= sigEntry)
    buy := false
if sell and (na(sigTgt) or sigTgt >= sigEntry or sigStop <= sigEntry)
    sell := false

if buy or sell
    float risk = math.abs(sigEntry - sigStop)
    float rr = risk > 0 ? math.abs(sigTgt - sigEntry) / risk : na
    color c = buy ? color.new(#26a69a, 0) : color.new(#ef5350, 0)
    string txt = (buy ? 'BUY ' : 'SELL ') + fmt(sigEntry) + '\nSL ' + fmt(sigStop) + '\nTP ' + fmt(sigTgt) + '   ' + str.tostring(rr, '#.#') + 'R'
    label.new(bar_index, buy ? low : high, txt, xloc=xloc.bar_index, yloc=buy ? yloc.belowbar : yloc.abovebar, style=buy ? label.style_label_up : label.style_label_down, color=c, textcolor=color.white, size=size.small)
    line.new(bar_index, sigEntry, bar_index + planLen, sigEntry, xloc=xloc.bar_index, color=#42a5f5, width=2)
    line.new(bar_index, sigStop, bar_index + planLen, sigStop, xloc=xloc.bar_index, color=#ef5350, width=1, style=line.style_dashed)
    line.new(bar_index, sigTgt, bar_index + planLen, sigTgt, xloc=xloc.bar_index, color=#26a69a, width=1, style=line.style_dashed)

alertcondition(buy, title='Buy', message='ST VR BUY - price closed back inside the value area from below')
alertcondition(sell, title='Sell', message='ST VR SELL - price closed back inside the value area from above')

// ----------------------------------------------------------------------------
// Levels and profile
// ----------------------------------------------------------------------------
plot(ready ? poc : na, title='POC', color=colPoc, linewidth=2, style=plot.style_linebr)
p1 = plot(ready ? vah : na, title='VAH', color=colVa, style=plot.style_linebr)
p2 = plot(ready ? val : na, title='VAL', color=colVa, style=plot.style_linebr)
fill(p1, p2, color=color.new(colVa, 92), title='Value Area')
plot(ready ? rHi : na, title='Range High', color=color.new(#9e9e9e, 45), style=plot.style_linebr)
plot(ready ? rLo : na, title='Range Low', color=color.new(#9e9e9e, 45), style=plot.style_linebr)

if showProfile and barstate.islast and ready and pRows > 0
    float maxR = 0.0
    for r = 0 to pRows - 1
        maxR := math.max(maxR, array.get(upVol, r) + array.get(dnVol, r))
    maxR := maxR <= 0 ? 1.0 : maxR
    for r = 0 to pRows - 1
        float rBot = pGridLo + r * pStep
        float u = array.get(upVol, r)
        float d = array.get(dnVol, r)
        bool inVa = r >= pVaDn and r <= pVaUp
        int wu = int(math.round(profWidth * u / maxR))
        int wd = int(math.round(profWidth * d / maxR))
        color cu = r == pPoc ? color.new(colPoc, 45) : inVa ? colUp : color.new(colUp, 82)
        color cd = r == pPoc ? color.new(colPoc, 45) : inVa ? colDn : color.new(colDn, 82)
        if wu > 0
            box.new(bar_index + 3, rBot + pStep, bar_index + 3 + wu, rBot, xloc=xloc.bar_index, border_color=color.new(color.black, 100), bgcolor=cu)
        if wd > 0
            box.new(bar_index + 3 + wu, rBot + pStep, bar_index + 3 + wu + wd, rBot, xloc=xloc.bar_index, border_color=color.new(color.black, 100), bgcolor=cd)
