//@version=6
// SaintTrades Volume Range
//
// A fixed range volume profile, reduced to what you act on.
//
// The profile is built from the last N bars and marks the POC and the value
// area. When price leaves value, holds out, and closes back in, three lines go
// on the chart: where to get in, where to be out, and where to take it off.
// Nothing is drawn that you would not put an order against.
//
// Any symbol, any timeframe. No sessions, nothing to set per instrument.
indicator('SaintTrades Volume Range', shorttitle='ST VR', overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=1000)

// ----------------------------------------------------------------------------
// Inputs
// ----------------------------------------------------------------------------
lenBars = input.int(200, title='Range (bars)', minval=20, maxval=500, tooltip='Bars the profile is built from.')
rows = input.int(40, title='Rows', minval=10, maxval=120)
vaPct = input.float(70, title='Value Area %', minval=30, maxval=95, step=1)
anchorMode = input.string('Rolling', title='Range Anchor', options=['Rolling', 'Fixed block'], tooltip='Rolling rebuilds the profile every bar, so the levels follow price. Fixed block builds it once every N bars and holds it, so price travels further before it comes back.')

grpSig = 'Signal'
confirmBars = input.int(2, title='Bars Outside First', minval=1, maxval=20, group=grpSig, tooltip='How long price must hold beyond the value area before a close back inside counts.')
minR = input.float(1.5, title='Minimum R', minval=0, step=0.1, group=grpSig, tooltip='Signals worth less than this much reward per unit of risk are not shown. The stop is set by how far price ran while it was outside value, so a deep excursion gives a wide stop and a poor R.')
planLen = input.int(40, title='Line Length (bars)', minval=5, maxval=200, group=grpSig)

grpDisp = 'Display'
showProfile = input.bool(true, title='Show Profile', group=grpDisp, tooltip='The histogram is drawn clear of the last bar so it never sits on top of price. Rows inside the value area are solid, the rest are faded, and the POC is picked out.')
profWidth = input.int(70, title='Profile Width (bars)', minval=10, maxval=250, group=grpDisp)
colPoc = input.color(#ffb300, title='POC', inline='c', group=grpDisp)
colVa = input.color(#42a5f5, title='Value', inline='c', group=grpDisp)

fmt(float p) => str.tostring(p, format.mintick)

// ----------------------------------------------------------------------------
// Profile
// ----------------------------------------------------------------------------
var float poc = na
var float vah = na
var float val = na
var float vaStep = na

// Held for the histogram, which is drawn on the last bar from the finished rows
var array<float> pRows = array.new<float>(0)
var float pLo = na
var float pStep = na
var float pMax = na
var int pPocIdx = 0
var int pVaUp = 0
var int pVaDn = 0

bool roll = anchorMode == 'Fixed block' ? (bar_index >= lenBars and bar_index % lenBars == 0) : (bar_index > lenBars + 1)

if roll
    float hi = high[1]
    float lo = low[1]
    for i = 1 to lenBars
        hi := math.max(hi, high[i])
        lo := math.min(lo, low[i])

    float step = (hi - lo) / rows
    step := step <= 0 ? syminfo.mintick : step

    array<float> rowVol = array.new<float>(rows, 0.0)

    // Each bar spreads across every row it spans. A bar is not all at its close.
    for i = 1 to lenBars
        float bh = high[i]
        float bl = low[i]
        if not na(bh) and not na(bl)
            float span = bh - bl
            float v = nz(volume[i], 1.0)
            v := v <= 0 ? 1.0 : v
            int r1 = math.max(0, math.min(rows - 1, int(math.floor((bl - lo) / step))))
            int r2 = math.max(0, math.min(rows - 1, int(math.floor((bh - lo) / step))))
            for r = r1 to r2
                float rBot = lo + r * step
                float overlap = math.min(bh, rBot + step) - math.max(bl, rBot)
                float share = span <= 0 ? 1.0 : math.max(overlap, 0) / span
                array.set(rowVol, r, array.get(rowVol, r) + v * share)

    float total = 0.0
    float maxRow = 0.0
    for r = 0 to rows - 1
        float t = array.get(rowVol, r)
        total += t
        maxRow := math.max(maxRow, t)

    // A tie goes to the row nearest the middle, not the lowest price.
    int pocIdx = 0
    float mid = (rows - 1) / 2.0
    float best = rows + 1.0
    for r = 0 to rows - 1
        if array.get(rowVol, r) >= maxRow
            float d = math.abs(r - mid)
            if d < best
                best := d
                pocIdx := r

    // Grown out from the POC two rows a side, the way a Market Profile does.
    int vaUp = pocIdx
    int vaDn = pocIdx
    float acc = array.get(rowVol, pocIdx)
    float target = total * vaPct / 100.0
    for _i = 0 to rows - 1
        if acc >= target
            break
        float sumUp = -1.0
        int upRows = 0
        if vaUp + 1 <= rows - 1
            sumUp := array.get(rowVol, vaUp + 1)
            upRows := 1
            if vaUp + 2 <= rows - 1
                sumUp += array.get(rowVol, vaUp + 2)
                upRows := 2
        float sumDn = -1.0
        int dnRows = 0
        if vaDn - 1 >= 0
            sumDn := array.get(rowVol, vaDn - 1)
            dnRows := 1
            if vaDn - 2 >= 0
                sumDn += array.get(rowVol, vaDn - 2)
                dnRows := 2
        if upRows == 0 and dnRows == 0
            break
        if sumUp >= sumDn
            vaUp += upRows
            acc += sumUp
        else
            vaDn -= dnRows
            acc += sumDn

    poc := math.round((lo + (pocIdx + 0.5) * step) / syminfo.mintick) * syminfo.mintick
    vah := math.min(math.round((lo + (vaUp + 1) * step) / syminfo.mintick) * syminfo.mintick, hi)
    val := math.max(math.round((lo + vaDn * step) / syminfo.mintick) * syminfo.mintick, lo)
    vaStep := step
    pRows := array.copy(rowVol)
    pLo := lo
    pStep := step
    pMax := maxRow <= 0 ? 1.0 : maxRow
    pPocIdx := pocIdx
    pVaUp := vaUp
    pVaDn := vaDn

bool ready = not na(val) and not na(vah)

// ----------------------------------------------------------------------------
// Signal
//
// Price leaves value, holds out, closes back in. The stop goes beyond the
// extreme it reached while out, because through that the move back has failed.
// The target is the POC, which is what price came back for.
// ----------------------------------------------------------------------------
var int barsBelow = 0
var int barsAbove = 0
var float outLow = na
var float outHigh = na

bool buy = false
bool sell = false
float sigEntry = na
float sigStop = na
float sigTgt = na

if ready
    if close < val
        barsBelow += 1
        barsAbove := 0
        outLow := na(outLow) ? low : math.min(outLow, low)
        outHigh := na
    else if close > vah
        barsAbove += 1
        barsBelow := 0
        outHigh := na(outHigh) ? high : math.max(outHigh, high)
        outLow := na
    else
        if barsBelow >= confirmBars and not na(outLow)
            buy := true
            sigEntry := close
            sigStop := math.round((outLow - vaStep) / syminfo.mintick) * syminfo.mintick
            sigTgt := poc
        if barsAbove >= confirmBars and not na(outHigh)
            sell := true
            sigEntry := close
            sigStop := math.round((outHigh + vaStep) / syminfo.mintick) * syminfo.mintick
            sigTgt := poc
        barsBelow := 0
        barsAbove := 0
        outLow := na
        outHigh := na

// A target the wrong side of entry is not a trade, and neither is one that pays
// less than the minimum asked for. The stop is set by how far price ran while
// it was outside, so a deep excursion can leave a target that is not worth the
// risk of reaching it.
float sigRisk = math.abs(sigEntry - sigStop)
float sigR = sigRisk > 0 ? math.abs(sigTgt - sigEntry) / sigRisk : na

if buy and (na(sigTgt) or sigTgt <= sigEntry or sigStop >= sigEntry or na(sigR) or sigR < minR)
    buy := false
if sell and (na(sigTgt) or sigTgt >= sigEntry or sigStop <= sigEntry or na(sigR) or sigR < minR)
    sell := false

if buy or sell
    int x1 = bar_index
    int x2 = bar_index + planLen
    // Three lines, each carrying its own price. Nothing else goes on the chart.
    line.new(x1, sigEntry, x2, sigEntry, xloc=xloc.bar_index, color=#42a5f5, width=3)
    line.new(x1, sigStop, x2, sigStop, xloc=xloc.bar_index, color=#ef5350, width=1)
    line.new(x1, sigTgt, x2, sigTgt, xloc=xloc.bar_index, color=#26a69a, width=1)
    label.new(x2, sigEntry, (buy ? ' BUY ' : ' SELL ') + fmt(sigEntry), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=#42a5f5, size=size.normal)
    label.new(x2, sigStop, ' SL ' + fmt(sigStop), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=#ef5350, size=size.small)
    label.new(x2, sigTgt, ' TP ' + fmt(sigTgt) + '  ' + str.tostring(sigR, '#.#') + 'R', xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=#26a69a, size=size.small)

alertcondition(buy, title='Buy', message='ST VR BUY - price closed back inside the value area from below')
alertcondition(sell, title='Sell', message='ST VR SELL - price closed back inside the value area from above')

// ----------------------------------------------------------------------------
// Levels
// ----------------------------------------------------------------------------
plot(ready ? poc : na, title='POC', color=colPoc, linewidth=2, style=plot.style_linebr)
p1 = plot(ready ? vah : na, title='VAH', color=colVa, style=plot.style_linebr)
p2 = plot(ready ? val : na, title='VAL', color=colVa, style=plot.style_linebr)
fill(p1, p2, color=color.new(colVa, 94), title='Value Area')

// The histogram, drawn once on the last bar and clear of it, so it reads as a
// profile beside the chart rather than shading laid over the candles. One
// colour: solid inside value, faded outside, the POC picked out.
if showProfile and barstate.islast and ready and array.size(pRows) > 0
    int anchor = bar_index + 4
    for r = 0 to array.size(pRows) - 1
        float w = profWidth * array.get(pRows, r) / pMax
        int wi = int(math.round(w))
        if wi > 0
            float rBot = pLo + r * pStep
            bool inVa = r >= pVaDn and r <= pVaUp
            color c = r == pPocIdx ? color.new(colPoc, 25) : inVa ? color.new(colVa, 55) : color.new(colVa, 85)
            box.new(anchor, rBot + pStep, anchor + wi, rBot, xloc=xloc.bar_index, border_color=color.new(color.black, 100), bgcolor=c)
