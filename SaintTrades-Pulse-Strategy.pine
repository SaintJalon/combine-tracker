//@version=6
// SaintTrades Pulse - Strategy
//
// The SaintTrades Pulse rules wired into the Strategy Tester, so the signal
// engine can be measured instead of eyeballed. The engine below is the same
// code the indicator runs: same EMAs, same higher timeframe filter, same chop
// test, same zones, same quality score, same stop and the same three targets.
//
// Four things keep this an honest test rather than a flattering one:
//
//   Orders are placed at the close of the signal bar and fill at the open of
//   the next one. The indicator prints its entry at the close because that is
//   where you saw it; a backtest that also filled you there would be paying
//   you a price the signal itself created.
//
//   The bracket goes in with the entry, not a bar later, so a trade that runs
//   straight to its stop on the fill bar is stopped on the fill bar.
//
//   Everything from the higher timeframe is read one bar back, so no order is
//   ever placed on a bar that had not finished forming.
//
//   Commission and slippage are on by default. A stop this tight looks superb
//   with neither and is usually a loser with both. Set them to your broker in
//   Properties before you believe any number this prints.
//
// Margin is set to zero on both sides. One NQ contract carries something like
// six hundred thousand dollars of notional, so against a fifty thousand dollar
// account the tester rejects every order and reports nothing at all. Zero means
// it stops checking notional against equity and lets the position size input do
// the sizing, which is what a futures account with day trade margin actually
// behaves like.
//
// The Strategy Tester reports dollars. The table on the chart reports R, which
// is the number that survives a change of account size.
strategy('SaintTrades Pulse Strategy', shorttitle='ST Pulse Strat', overlay=true, max_bars_back=5000, max_boxes_count=500, max_lines_count=500, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=2.5, slippage=1, pyramiding=0, margin_long=0, margin_short=0)

// ----------------------------------------------------------------------------
// Inputs
// ----------------------------------------------------------------------------
grpTrend = 'Trend'
fastLen = input.int(9, title='Fast EMA', minval=2, group=grpTrend)
slowLen = input.int(21, title='Slow EMA', minval=3, group=grpTrend)
htfAuto = input.bool(true, title='Higher Timeframe Follows Chart', group=grpTrend, tooltip='On a 1m chart the higher timeframe is 5m, on 5m it is 15m, and so on up. Turn this off to pin one.')
htfPin = input.timeframe('60', title='Higher Timeframe', group=grpTrend)
htfLen = input.int(50, title='HTF EMA', minval=5, group=grpTrend)

grpSig = 'Signals'
armLen = input.int(12, title='Pullback Window (bars)', minval=2, maxval=60, group=grpSig, tooltip='How long a pullback stays live. Price has to touch the fast EMA and then push off it inside this many bars, or the setup is dropped.')
allowRev = input.bool(true, title='Reversal Trades', group=grpSig, tooltip='Takes a sweep of a recent high or low that closes straight back inside. Off means continuation only.')
swpLen = input.int(20, title='Sweep Lookback (bars)', minval=5, maxval=100, group=grpSig)
minQual = input.int(55, title='Minimum Quality', minval=0, maxval=100, group=grpSig, tooltip='Signals scoring under this are not taken. 75 and up reads as an A, 55 to 74 a B. This is the first dial to turn when the tester shows too many trades.')
dirFilter = input.string('Both', title='Direction Filter', options=['Both', 'Long Only', 'Short Only'], group=grpSig)

grpChop = 'Chop Filter'
useChop = input.bool(true, title='Hold Signals in Chop', group=grpChop)
adxLen = input.int(14, title='ADX Length', minval=2, group=grpChop)
adxMin = input.float(18, title='Trend Threshold', minval=5, maxval=50, step=0.5, group=grpChop, tooltip='ADX under this reads as chop.')
erLen = input.int(14, title='Efficiency Length', minval=3, group=grpChop)
erMin = input.float(0.28, title='Minimum Efficiency', minval=0, maxval=1, step=0.01, group=grpChop, tooltip='How much of the distance price travelled ended up as progress. Low means it is going nowhere in a hurry.')

grpZone = 'Supply & Demand'
pivLen = input.int(5, title='Pivot Length', minval=2, maxval=25, group=grpZone)
maxZones = input.int(6, title='Zones Per Side', minval=1, maxval=15, group=grpZone)
htfZones = input.bool(true, title='Higher Timeframe Zones', group=grpZone)
showZones = input.bool(false, title='Plot Zones', group=grpZone, tooltip='The zones are always computed, because entering off one is worth points in the quality score. This only decides whether they are drawn.')

grpTrade = 'Trade'
structLen = input.int(10, title='Stop Structure (bars)', minval=3, maxval=60, group=grpTrade, tooltip='The stop goes beyond the low or high of this many bars, plus a buffer.')
stopBuf = input.float(0.35, title='Stop Buffer (ATR)', minval=0, maxval=3, step=0.05, group=grpTrade)
r1 = input.float(1.0, title='TP1 (R)', minval=0.25, step=0.25, inline='r', group=grpTrade)
r2 = input.float(2.0, title='TP2 (R)', minval=0.5, step=0.25, inline='r', group=grpTrade)
r3 = input.float(3.0, title='TP3 (R)', minval=0.75, step=0.25, inline='r', group=grpTrade)
p1 = input.int(50, title='% Off At TP1', minval=0, maxval=100, inline='p', group=grpTrade)
p2 = input.int(25, title='% Off At TP2', minval=0, maxval=100, inline='p', group=grpTrade, tooltip='What is left runs to TP3. On a single contract nothing can be split, so the whole thing comes off at TP1.')
beAtTp1 = input.bool(true, title='Stop to Breakeven at TP1', group=grpTrade, tooltip='Breakeven is the price you were actually filled at, not the price the signal printed.')
maxRiskAtr = input.float(2.5, title='Maximum Risk (ATR)', minval=0.5, maxval=10, step=0.1, group=grpTrade, tooltip='A signal whose stop sits further away than this is skipped. A wide stop is a bad price, not a bigger edge.')

grpRisk = 'Risk'
sizeMode = input.string('Risk Based', title='Size By', options=['Risk Based', 'Fixed Contracts'], group=grpRisk)
riskDollars = input.float(300, title='Risk Per Trade ($)', minval=1, step=25, group=grpRisk, tooltip='Contracts are worked out from the stop distance. A stop too wide to fit this budget in one contract is not traded at all.')
fixedQty = input.int(1, title='Fixed Contracts', minval=1, group=grpRisk)
maxContracts = input.int(10, title='Max Contracts', minval=1, group=grpRisk)

grpWhen = 'When To Trade'
useSession = input.bool(true, title='Restrict To Session', group=grpWhen)
sessionStr = input.session('0930-1600', title='Session', group=grpWhen, tooltip='Entries are only placed inside this window. Exits always work.')
maxTrades = input.int(3, title='Max Trades Per Day', minval=1, maxval=20, group=grpWhen)
flatOutside = input.bool(true, title='Flat Outside The Session', group=grpWhen, tooltip='Closes anything still open once the window ends, rather than carrying it overnight.')

grpDisp = 'Display'
showPlan = input.bool(true, title='Plot The Bracket', group=grpDisp)
showStats = input.bool(true, title='R Stats Table', group=grpDisp)
dashPos = input.string('Bottom Left', title='Table Position', options=['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left', 'Middle Right'], group=grpDisp, tooltip='Bottom left by default because the indicator puts its own dashboard top right, and with both on one chart they sit on top of each other.')
colUp = input.color(#26a69a, title='Up', inline='c', group=grpDisp)
colDn = input.color(#ef5350, title='Down', inline='c', group=grpDisp)
colFlat = input.color(#787b86, title='Flat', inline='c', group=grpDisp)

fmt(float p) => str.tostring(p, format.mintick)
tick(float p) => math.round(p / syminfo.mintick) * syminfo.mintick

// ----------------------------------------------------------------------------
// Trend
// ----------------------------------------------------------------------------
int chartSec = timeframe.in_seconds(timeframe.period)
string htfAutoTf = chartSec <= 60 ? '5' : chartSec <= 180 ? '15' : chartSec <= 300 ? '30' : chartSec <= 900 ? '60' : chartSec <= 1800 ? '120' : chartSec <= 3600 ? '240' : chartSec <= 14400 ? 'D' : 'W'
string htf = htfAuto ? htfAutoTf : htfPin

[htfEma, htfEmaP, htfC, htfPh, htfPl, htfAtr] = request.security(syminfo.tickerid, htf, [ta.ema(close, htfLen)[1], ta.ema(close, htfLen)[2], close[1], ta.pivothigh(pivLen, pivLen)[1], ta.pivotlow(pivLen, pivLen)[1], ta.atr(14)[1]], lookahead=barmerge.lookahead_off)

float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)
float atr = ta.atr(14)
float rsi = ta.rsi(close, 14)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
float volAvg = ta.sma(volume, 20)

bool htfUp = not na(htfEma) and htfC > htfEma and htfEma >= htfEmaP
bool htfDn = not na(htfEma) and htfC < htfEma and htfEma <= htfEmaP
bool locUp = emaFast > emaSlow and close > emaSlow
bool locDn = emaFast < emaSlow and close < emaSlow

// ----------------------------------------------------------------------------
// Chop
// ----------------------------------------------------------------------------
float move = math.abs(close - close[erLen])
float path = math.sum(math.abs(close - close[1]), erLen)
float er = path > 0 ? move / path : 0.0
bool chop = adx < adxMin or er < erMin

// ----------------------------------------------------------------------------
// Structure
// ----------------------------------------------------------------------------
float ph = ta.pivothigh(pivLen, pivLen)
float pl = ta.pivotlow(pivLen, pivLen)

var float lastPh = na
var float prevPh = na
var float lastPl = na
var float prevPl = na

if not na(ph)
    prevPh := lastPh
    lastPh := ph
if not na(pl)
    prevPl := lastPl
    lastPl := pl

bool hh = not na(lastPh) and not na(prevPh) and lastPh > prevPh
bool lh = not na(lastPh) and not na(prevPh) and lastPh < prevPh
bool hl = not na(lastPl) and not na(prevPl) and lastPl > prevPl
bool ll = not na(lastPl) and not na(prevPl) and lastPl < prevPl
int structDir = hh and hl ? 1 : lh and ll ? -1 : 0

// ----------------------------------------------------------------------------
// Supply and demand
// ----------------------------------------------------------------------------
var array<box> dZones = array.new<box>()
var array<box> sZones = array.new<box>()
var array<bool> dHtf = array.new<bool>()
var array<bool> sHtf = array.new<bool>()

zoneEdge(bool dem, bool htfZ) => color.new(dem ? colUp : colDn, showZones ? (htfZ ? 25 : 45) : 100)
zoneFill(bool dem, bool htfZ) => color.new(dem ? colUp : colDn, showZones ? (htfZ ? 82 : 90) : 100)

addZone(array<box> arr, array<bool> flags, float top, float bot, int left, bool dem, bool htfZ) =>
    box b = box.new(left, top, bar_index + 3, bot, xloc=xloc.bar_index, border_color=zoneEdge(dem, htfZ), border_width=htfZ ? 2 : 1, bgcolor=zoneFill(dem, htfZ))
    array.push(arr, b)
    array.push(flags, htfZ)
    if array.size(arr) > maxZones
        box old = array.shift(arr)
        array.shift(flags)
        box.delete(old)

if not na(pl)
    float bot = low[pivLen]
    float top = math.max(math.max(open[pivLen], close[pivLen]), bot + atr * 0.2)
    addZone(dZones, dHtf, top, bot, bar_index - pivLen, true, false)

if not na(ph)
    float top = high[pivLen]
    float bot = math.min(math.min(open[pivLen], close[pivLen]), top - atr * 0.2)
    addZone(sZones, sHtf, top, bot, bar_index - pivLen, false, false)

if htfZones and not na(htfPl) and (na(htfPl[1]) or htfPl != htfPl[1])
    addZone(dZones, dHtf, htfPl + nz(htfAtr, atr) * 0.5, htfPl, bar_index - 1, true, true)

if htfZones and not na(htfPh) and (na(htfPh[1]) or htfPh != htfPh[1])
    addZone(sZones, sHtf, htfPh, htfPh - nz(htfAtr, atr) * 0.5, bar_index - 1, false, true)

keepZones(array<box> arr, array<bool> flags, bool dem) =>
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            box b = array.get(arr, i)
            bool hz = array.get(flags, i)
            if dem ? close < box.get_bottom(b) : close > box.get_top(b)
                array.remove(arr, i)
                array.remove(flags, i)
                box.delete(b)
            else
                box.set_right(b, bar_index + 3)
                box.set_border_color(b, zoneEdge(dem, hz))
                box.set_bgcolor(b, zoneFill(dem, hz))

keepZones(dZones, dHtf, true)
keepZones(sZones, sHtf, false)

inZone(array<box> arr, float px, float tol) =>
    bool hit = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            box b = array.get(arr, i)
            if px >= box.get_bottom(b) - tol and px <= box.get_top(b) + tol
                hit := true
    hit

bool atDemand = inZone(dZones, low, atr * 0.15)
bool atSupply = inZone(sZones, high, atr * 0.15)

// ----------------------------------------------------------------------------
// Signal engine
// ----------------------------------------------------------------------------
var bool armLong = false
var bool armShort = false
var int armLongBar = 0
var int armShortBar = 0

if locUp and low <= emaFast
    armLong := true
    armLongBar := bar_index
if locDn and high >= emaFast
    armShort := true
    armShortBar := bar_index
if not locUp or bar_index - armLongBar > armLen
    armLong := false
if not locDn or bar_index - armShortBar > armLen
    armShort := false

bool trigLong = armLong and close > high[1] and close > emaFast and close > open and rsi > 50
bool trigShort = armShort and close < low[1] and close < emaFast and close < open and rsi < 50

if trigLong
    armLong := false
if trigShort
    armShort := false

float swpHi = ta.highest(high, swpLen)[1]
float swpLo = ta.lowest(low, swpLen)[1]
bool revLong = allowRev and low < swpLo and close > swpLo and close > open and rsi < 45
bool revShort = allowRev and high > swpHi and close < swpHi and close < open and rsi > 55

bool blocked = useChop and chop
bool rawLong = (trigLong or revLong) and not blocked and dirFilter != 'Short Only'
bool rawShort = (trigShort or revShort) and not blocked and dirFilter != 'Long Only'
bool isRevL = revLong and not trigLong
bool isRevS = revShort and not trigShort

score(int dir, bool rev) =>
    float s = rev ? 15.0 : (dir == 1 ? htfUp : htfDn) ? 30.0 : (dir == 1 ? htfDn : htfUp) ? 0.0 : 15.0
    s += math.min(25.0, adx / 40.0 * 25.0)
    float m = dir == 1 ? rsi - 50.0 : 50.0 - rsi
    s += math.min(20.0, math.max(0.0, m))
    s += (dir == 1 ? atDemand : atSupply) ? 15.0 : 0.0
    s += volume > volAvg ? 10.0 : 0.0
    s += structDir == dir ? 5.0 : 0.0
    math.max(0.0, math.min(100.0, s))

float qLong = score(1, isRevL)
float qShort = score(-1, isRevS)

float loN = ta.lowest(low, structLen)
float hiN = ta.highest(high, structLen)
float stopLong = tick(math.min(loN, low) - atr * stopBuf)
float stopShort = tick(math.max(hiN, high) + atr * stopBuf)
bool riskOkL = close - stopLong > syminfo.mintick and close - stopLong <= atr * maxRiskAtr
bool riskOkS = stopShort - close > syminfo.mintick and stopShort - close <= atr * maxRiskAtr

bool sigLong = rawLong and riskOkL and qLong >= minQual
bool sigShort = rawShort and riskOkS and qShort >= minQual

// ----------------------------------------------------------------------------
// Orders
//
// One position at a time. The bracket is worked out here, at the signal, and
// submitted with the entry so it is live the moment the fill happens.
//
// The order of what follows matters. A trade that closes on the same bar a new
// signal fires has to be booked before the new bracket is built, or the
// bookkeeping wipes the trade it was meant to record.
// ----------------------------------------------------------------------------
var int tradesToday = 0
bool newDay = timeframe.change('D')
if newDay
    tradesToday := 0

bool inWindow = not useSession or not na(time(timeframe.period, sessionStr))
bool flat = strategy.position_size == 0

// The bracket, frozen at the signal and left alone afterwards except for the
// move to breakeven.
var int bDir = 0
var float bStop = na
var float bStopInit = na
var float bT1 = na
var float bT2 = na
var float bT3 = na
var int bQ1 = 0
var int bQ2 = 0
var bool tk1 = false
var bool tk2 = false

// R is taken from the price actually filled, not the price the signal printed,
// and the whole position is one result no matter how many pieces it came off in.
var float fillPx = na
var float netAtOpen = na
var bool badFill = false
var bool inPlay = false
var int bQty = 0
var int closedSeen = 0
var int rN = 0
var int rWin = 0
var float rSum = 0.0
var float rBest = na
var float rWorst = na
var float lastR = na
var int sigCount = 0
var int takenAll = 0

// A finished position, booked. Net profit is realised and includes commission,
// so this is the number that actually landed in the account divided by the
// number that was actually at risk.
//
// The test is a flat account and a trade log that has grown, not a change in
// position size. Position size alone would miss a trade that opened and stopped
// out inside a single bar, which on a fast chart is exactly the trade you want
// counted against you.
bool booked = inPlay and strategy.position_size == 0 and strategy.closedtrades > closedSeen

if booked
    float entPx = strategy.closedtrades.entry_price(strategy.closedtrades - 1)
    bool bad = badFill or na(entPx) or na(bStopInit) or (bDir == 1 and entPx <= bStopInit) or (bDir == -1 and entPx >= bStopInit)
    float riskU = bad ? na : math.abs(entPx - bStopInit) * syminfo.pointvalue * bQty
    float r = na(riskU) or riskU <= 0 ? na : (strategy.netprofit - netAtOpen) / riskU
    if not na(r)
        lastR := r
        rN += 1
        rSum += r
        if r > 0
            rWin += 1
        rBest := na(rBest) ? r : math.max(rBest, r)
        rWorst := na(rWorst) ? r : math.min(rWorst, r)
    bStop := na
    bStopInit := na
    bT1 := na
    bT2 := na
    bT3 := na
    bDir := 0
    badFill := false
    inPlay := false

closedSeen := strategy.closedtrades

float planStop = sigLong ? stopLong : stopShort
float planRisk = math.abs(close - planStop)
float perUnit = planRisk * syminfo.pointvalue
int sized = sizeMode == 'Fixed Contracts' ? fixedQty : perUnit > 0 ? int(math.floor(riskDollars / perUnit)) : 0
int qty = math.max(0, math.min(sized, maxContracts))

if sigLong or sigShort
    sigCount += 1

bool armed = (sigLong or sigShort) and inWindow and flat and qty > 0 and tradesToday < maxTrades

if armed
    int dir = sigLong ? 1 : -1
    float risk = math.abs(close - planStop)
    bDir := dir
    bStopInit := planStop
    bStop := planStop
    bT1 := tick(close + dir * risk * r1)
    bT2 := tick(close + dir * risk * r2)
    bT3 := tick(close + dir * risk * r3)
    // Whole contracts only. A single contract cannot be thirded, so it leaves
    // at TP1 and the runner rows are simply empty.
    bQ1 := math.min(qty, int(math.round(qty * p1 / 100.0)))
    bQ2 := math.min(qty - bQ1, int(math.round(qty * p2 / 100.0)))
    bQty := qty
    inPlay := true
    tradesToday += 1
    takenAll += 1
    tk1 := false
    tk2 := false
    badFill := false
    // Taken here, while the account is still flat, so a target that fills on
    // the same bar as the entry is counted in this trade rather than lost.
    netAtOpen := strategy.netprofit
    if dir == 1
        strategy.entry('L', strategy.long, qty=qty)
    else
        strategy.entry('S', strategy.short, qty=qty)

bool justOpened = strategy.position_size != 0 and strategy.position_size[1] == 0

if justOpened
    fillPx := strategy.position_avg_price
    // A gap through the stop before the fill leaves a position with the stop on
    // the wrong side of entry. There is no trade there to manage, and no honest
    // R to take from it either.
    if (bDir == 1 and fillPx <= bStopInit) or (bDir == -1 and fillPx >= bStopInit)
        badFill := true
        strategy.close_all(comment='bad fill')

// Reaching the price is the fill. strategy.exit does not remember that an id has
// already filled, so re-issuing TP1 would shave the runner again on every bar it
// survives.
if strategy.position_size != 0 and not na(bStop)
    if not tk1 and not na(bT1) and (bDir == 1 ? high >= bT1 : low <= bT1)
        tk1 := true
        if beAtTp1
            bStop := tick(fillPx)
    if not tk2 and not na(bT2) and (bDir == 1 ? high >= bT2 : low <= bT2)
        tk2 := true

string eid = bDir == 1 ? 'L' : 'S'

if not na(bStop) and not badFill
    if bQ1 > 0 and not tk1
        strategy.exit('TP1', from_entry=eid, qty=bQ1, stop=bStop, limit=bT1)
    if bQ2 > 0 and not tk2
        strategy.exit('TP2', from_entry=eid, qty=bQ2, stop=bStop, limit=bT2)
    strategy.exit('TP3', from_entry=eid, stop=bStop, limit=bT3)

if flatOutside and not inWindow and strategy.position_size != 0
    strategy.close_all(comment='session end')

// ----------------------------------------------------------------------------
// The bracket on the chart, so the fills can be checked against what was asked
// ----------------------------------------------------------------------------
bool live = showPlan and strategy.position_size != 0
plot(live ? bStop : na, title='Stop', color=colDn, style=plot.style_linebr, linewidth=1)
plot(live ? bT1 : na, title='TP1', color=colUp, style=plot.style_linebr, linewidth=1)
plot(live ? bT2 : na, title='TP2', color=color.new(colUp, 30), style=plot.style_linebr, linewidth=1)
plot(live ? bT3 : na, title='TP3', color=color.new(colUp, 50), style=plot.style_linebr, linewidth=1)
plot(live ? fillPx : na, title='Entry', color=#42a5f5, style=plot.style_linebr, linewidth=2)

plotshape(armed and sigLong, title='Buy', style=shape.triangleup, location=location.belowbar, color=colUp, size=size.small)
plotshape(armed and sigShort, title='Sell', style=shape.triangledown, location=location.abovebar, color=colDn, size=size.small)

// ----------------------------------------------------------------------------
// R stats
// ----------------------------------------------------------------------------
var table stats = table.new(dashPos == 'Top Left' ? position.top_left : dashPos == 'Bottom Right' ? position.bottom_right : dashPos == 'Bottom Left' ? position.bottom_left : dashPos == 'Middle Right' ? position.middle_right : position.top_right, 2, 9, bgcolor=color.new(#131722, 12), frame_color=color.new(colFlat, 55), frame_width=1, border_color=color.new(colFlat, 80), border_width=1)

srow(int r, string k, string v, color c) =>
    table.cell(stats, 0, r, k, text_color=color.new(colFlat, 15), text_size=size.small, text_halign=text.align_left)
    table.cell(stats, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)

if barstate.islast and showStats
    float avgR = rN > 0 ? rSum / rN : na
    float winPct = rN > 0 ? rWin * 100.0 / rN : na
    string posTxt = strategy.position_size == 0 ? 'FLAT' : (strategy.position_size > 0 ? 'LONG ' : 'SHORT ') + str.tostring(math.abs(strategy.position_size), '#') + ' @ ' + fmt(fillPx)

    table.cell(stats, 0, 0, ' PULSE  -  R STATS ', text_color=color.new(color.white, 0), text_size=size.small, text_halign=text.align_left, bgcolor=color.new(#42a5f5, 60))
    table.cell(stats, 1, 0, syminfo.ticker + '  ' + timeframe.period, text_color=color.new(color.white, 20), text_size=size.small, text_halign=text.align_right, bgcolor=color.new(#42a5f5, 60))

    srow(1, ' Trades', str.tostring(rN), color.new(color.white, 15))
    srow(2, ' Win Rate', rN > 0 ? str.tostring(winPct, '#.#') + '%' : '-', na(winPct) ? colFlat : winPct >= 50 ? colUp : colDn)
    srow(3, ' Average R', rN > 0 ? str.tostring(avgR, '#.##') + 'R' : '-', na(avgR) ? colFlat : avgR > 0 ? colUp : colDn)
    srow(4, ' Total R', rN > 0 ? str.tostring(rSum, '#.##') + 'R' : '-', rSum > 0 ? colUp : rSum < 0 ? colDn : colFlat)
    srow(5, ' Best / Worst', rN > 0 ? str.tostring(rBest, '#.##') + '  /  ' + str.tostring(rWorst, '#.##') : '-', color.new(color.white, 25))
    srow(6, ' Last Trade', na(lastR) ? '-' : str.tostring(lastR, '#.##') + 'R', na(lastR) ? colFlat : lastR > 0 ? colUp : colDn)
    srow(7, ' Signals / Taken', str.tostring(sigCount) + '  /  ' + str.tostring(takenAll), sigCount > 0 and takenAll == 0 ? #ffb300 : color.new(color.white, 25))
    srow(8, ' Position', posTxt, strategy.position_size > 0 ? colUp : strategy.position_size < 0 ? colDn : colFlat)
