//@version=6
// =============================================================================
// SaintTrades RB Flow (key level → 5m RB → 1H RB)                     INDICATOR
// -----------------------------------------------------------------------------
// The model: price rejects a key level (above all the previous 4H high or low)
// with a 5-minute rejection block, then runs to the nearest 1-hour rejection
// block on the other side. Rejection blocks follow JS RB's rules exactly. Every signal gets an entry, a stop past
// the 5m RB's tip and a target at the 1H RB. Each signal is traded three ways
// and scored, so the table and the Pine Logs show whether the model paid on
// this chart, day by day. Non-repainting: everything runs on closed bars only.
//
// --------------------------------- RULES -------------------------------------
//  R1. Rejection blocks follow JS RB on both timeframes. Every swing high/low
//      (strictly beyond N candles each side, "Swing strength") is liquidity
//      until a wick trades through it. The candle whose wick takes it while its
//      body stays on the near side is an RB. Zone = body edge to wick tip,
//      CE = 50% of the wick. An RB lasts until a later wick trades past its tip.
//  R2. Key levels, as SaintTrades KeyLevels draws them: previous 4H high/low,
//      previous day high/low, daily / weekly / monthly / quarterly / yearly
//      opens, previous week and month high/low, Monday high/low, Asia high/low,
//      and optionally London high/low and the previous week/month mids.
//      Highs only count for bearish RBs, lows for bullish RBs. Opens and mids
//      count both ways.
//  R3. Setup "Sweep": a 5m RB whose wick reaches a key level while its whole
//      body stays on the near side. A high or low that a 5m candle has closed
//      beyond is broken and stops counting. A level gives at most one signal
//      per direction (input).
//  R4. Setup "4H RB": the 5m RB that made a 4H candle's high (bearish) or low
//      (bullish), e.g. the last 5m candle before 10:00 wicking out the 4H high.
//      It is known when that 4H candle closes: the market entry is that close;
//      the limit entries wait for a retest during the next 4H candle.
//  R5. Target: the nearest live opposing 1H RB beyond the entry, the boxes JS
//      RB draws. Shorts run to a bullish 1H RB below, longs to a bearish 1H RB
//      above. TP = its near edge (first touch) or its CE. By default the 1H RBs
//      are built on the 1H chart's own full history, as JS RB builds them.
//  R6. Stop = 5m RB tip + buffer. A trade is taken only when the target is at
//      least the minimum R:R away.
//  R7. Entries, all measured on every signal:
//        RB close (market)  - at the 5m RB's close; for a 4H RB, at the close
//                             of the 4H candle it made the high / low of.
//        Body-edge limit    - at the near edge of the 5m zone.
//        CE limit           - at 50% of the 5m wick.
//        Confirmation close - wait for a 5m candle to close back
//                             through the CISD level, the open of the run of
//                             candles that pushed into the RB, and enter at that
//                             close. The stop stays past the RB's tip.
//
// ------------------------------- ASSUMPTIONS ---------------------------------
//  A1. 5m, 1H and 4H candles are built from chart bars and finalized on their
//      last chart bar. If that bar can't be detected (a session break), the
//      candle is finalized on the next bar; a 5m RB found late is dropped if
//      that bar already traded past its tip, and its market entry is that
//      bar's close.
//  A2. A level counts for a 5m candle only if it existed before that candle
//      opened. The previous 4H high/low are live from the bar after the 4H
//      candle closes; day / week / month / session levels from the first bar
//      of the new period.
//  A3. Fills are conservative. A limit fills from the bar after the signal. A
//      stop on the fill bar counts; a target on the fill bar doesn't. A market
//      entry fills at the signal close; its stop and target count from the
//      next bar. When a bar trades both the stop and the target, the stop wins.
//  A4. An unfilled limit is cancelled when price reaches the target first, when
//      it expires (Sweep: after N minutes; 4H RB: when the next 4H candle
//      closes), or at the flatten time.
//  A5. Flatten (default 16:00 NY): open trades close at that bar's close and no
//      new signals come until the 18:00 open.
//  A6. "Full to target" = the whole position to the 1H RB, same stop.
//      "½ at TP1 + breakeven" = half off at TP1, the stop moves to the entry
//      from the next bar, the rest runs to the 1H RB. Results are in R.
//  A7. While a trade is live (input): by default a new signal is skipped while
//      the shown entry's trade in the same direction is pending or open ("One at
//      a time" skips both directions). All four entries are measured on the
//      same signals.
//  A8. Trading day = 18:00 NY to 18:00 NY. A signal's result is booked on the
//      day it signalled.
// =============================================================================

indicator("SaintTrades RB Flow (Key level → 5m RB → 1H RB)", "ST RB Flow", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================== TYPES ========================================
type Candle
    float o
    float h
    float l
    float c
    int   t            // open time
    int   b            // first chart bar
    int   e            // chart bar it was finalized on
    bool  late = false

type Agg
    float o
    float h
    float l
    float c
    int   t
    int   b
    bool  done = true
    array<float> hb    // highs / lows of the last swing window
    array<float> lb
    array<float> hs    // swing highs no wick has taken yet (JS RB's BSL)
    array<float> ls    // swing lows no wick has taken yet (SSL)
    array<float> ho    // opens / closes of the last candles, for the CISD level
    array<float> hc

type Lvl
    float  price
    string name
    int    side        // 1 = high (bearish RBs), -1 = low (bullish RBs), 0 = open / mid (both)
    int    grp         // 0 = 4H, 1 = day, 2 = week and higher, 3 = session
    int    bornT       // earliest 5m-candle open time that may use it (A2)
    int    deadT       // replaced at this time
    bool   broken   = false
    bool   usedBull = false
    bool   usedBear = false

type Zone
    bool  bull
    float tip
    float edge
    float ce
    int   formT
    int   formBar
    int   endBar
    float cls
    bool  fresh = true
    bool  swept = false
    float cisd         // the confirmation level (R7)
    bool  dirC = false // the RB candle closed in the trade's direction

type Trade
    float  entry
    float  stop
    float  risk
    float  tgt
    float  rr
    float  tp1
    Zone   tz
    int    kind      = 0       // target: 0 = target-timeframe RB, 1 = opposite 4H level, 2 = fixed R
    string tgtName   = ""
    bool   mkt       = false
    bool   wait      = false   // confirmation entry still waiting for its close
    float  cisd
    int    waitN     = 0
    bool   valid     = false
    string why       = ""
    bool   filled    = false
    int    fillBar
    bool   cancelled = false
    bool   hit       = false
    bool   doneF     = false
    float  r         = 0.0
    int    exitF
    float  pxF
    bool   doneM     = false
    bool   t1Hit     = false
    int    t1Bar
    float  rM        = 0.0
    int    exitM
    float  pxM

type Sig
    bool   bull
    string setup
    string names
    int    grp
    int    tb          // 0 Asia, 1 London, 2 NY AM, 3 NY PM
    Zone   rb
    int    sigBar
    int    sigT
    int    day
    string dayName
    int    n4hAt
    Trade  t0
    Trade  t1
    Trade  t2
    Trade  t3
    bool   fPd      = false     // shorts above / longs below the daily open
    bool   resolved = false
    bool   drawn    = false
    box    rbBx
    box    tpBx
    box    slBx
    box    tzBx
    line   lnE
    line   lnT
    line   lnS
    label  tgE
    label  tgT
    label  tgS
    label  lb
    label  res

type State
    int   setups  = 0
    int   noTgt   = 0
    int   n4h     = 0
    int   days    = 0
    float eq      = 0.0
    float peak    = 0.0
    float maxDD   = 0.0
    int   lose    = 0
    int   maxLose = 0

// =============================== INPUTS ======================================
G_SET = "1 · Setups"
G_LV  = "2 · Key levels"
G_RB  = "3 · Rejection blocks (JS RB rules)"
G_TR  = "4 · Entry, stop & target"
G_VIS = "5 · Visuals"
G_ST  = "6 · Stats"

useSweep = input.bool(true, "Sweep: a 5m RB off a key level", tooltip="The 5m wick reaches a key level and the body closes back on the near side (R3).", group=G_SET)
use4hRb  = input.bool(true, "4H RB: the 5m RB that made the 4H high / low", tooltip="Known when the 4H candle closes: the market entry is taken at that close, the limit entries on a retest during the next 4H candle (R4).", group=G_SET)
entTfIn  = input.string("5m", "Entry RB timeframe", options=["1m", "3m", "5m", "15m"], group=G_SET)
tgtTfIn  = input.string("1H", "Target RB timeframe", options=["15m", "30m", "1H", "2H", "4H"], group=G_SET)
dirIn    = input.string("Both", "Direction", options=["Both", "Longs only", "Shorts only"], group=G_SET)
overlap  = input.string("Skip same direction", "While a trade is live", options=["Skip same direction", "One at a time", "Take every signal"], tooltip="Skip same direction: a new signal is skipped while the shown entry's trade in the same direction is pending or open; an opposite signal still shows. One at a time skips both (A7).", group=G_SET)
reqPd    = input.bool(false, "Only shorts above / longs below the daily open", tooltip="Premium / discount: a short only when the 5m RB's CE is above the 18:00 daily open, a long only when it is below. The breakdown scores it either way.", group=G_SET)
useWin   = input.bool(false, "Only signal inside (NY)", inline="win", group=G_SET)
winSess  = input.session("0800-1600", "", inline="win", group=G_SET)

use4H   = input.bool(true, "Previous 4H high / low", group=G_LV)
usePD   = input.bool(false, "Previous day high / low", group=G_LV)
useOpen = input.bool(false, "Daily / weekly / monthly / quarterly / yearly opens", group=G_LV)
usePW   = input.bool(false, "Previous week high / low", group=G_LV)
usePM   = input.bool(false, "Previous month high / low", group=G_LV)
useMon  = input.bool(false, "Monday high / low", group=G_LV)
useAsia = input.bool(false, "Asia high / low (NY)", inline="as", group=G_LV)
asiaSes = input.session("2000-0400", "", inline="as", group=G_LV)
useLon  = input.bool(false, "London high / low (NY)", inline="ln", group=G_LV)
lonSes  = input.session("0300-0900", "", inline="ln", group=G_LV)
useMid  = input.bool(false, "Previous week / month mids", group=G_LV)
tolTk   = input.int(0, "Wick may stop short of a level by (ticks)", minval=0, maxval=40, tooltip="0 = the wick must touch or trade through the level.", group=G_LV)
oncePer = input.bool(true, "One signal per level per direction", group=G_LV)

strengthIn = input.string("Sensitive", "Swing strength", options=["Sensitive", "Normal", "Strict"], tooltip="Set it the same as in JS RB. The swing highs/lows a wick must take out: Sensitive = 1 candle each side, Normal = 2 left / 3 right, Strict = 6 each side.", group=G_RB)
dirOnly    = input.bool(false, "Only RBs closing in trade direction", tooltip="Set it the same as in JS RB. Bullish RBs need a bullish close, bearish RBs a bearish close.", group=G_RB)
tgtSrc     = input.string("Full history (like JS RB)", "Target RBs from", options=["Full history (like JS RB)", "Chart history"], tooltip="Full history builds the target RBs on the target timeframe's own history, as JS RB does, so RBs older than the loaded chart still count. Chart history only uses the bars on the chart.", group=G_RB)

entrySel = input.string("RB close (market)", "Entry shown & alerted", options=["RB close (market)", "Body-edge limit", "CE limit", "Confirmation close"], tooltip="The table measures all four either way (R7). Confirmation close waits for a 5m close back through the open of the push into the RB, then enters at that close.", group=G_TR)
stopTk   = input.int(4, "Stop buffer past the tip (ticks)", minval=0, maxval=400, tooltip="4 ticks = 1 point on NQ / MNQ.", group=G_TR)
tpAt     = input.string("Near edge", "TP at the target RB's", options=["Near edge", "CE (50%)"], group=G_TR)
minRR    = input.float(1.5, "Minimum R:R to take a trade", minval=0, step=0.25, group=G_TR)
closeTgt = input.string("Use the next one out", "If the nearest target RB is closer than that", options=["Use the next one out", "Skip the trade"], group=G_TR)
noTgtIn  = input.string("Skip the trade", "If no target RB is far enough", options=["Opposite 4H high/low, then fixed R", "Fixed R target", "Skip the trade"], tooltip="Shorts aim for the previous 4H low and longs for the previous 4H high, when it is at least the minimum R:R away. Otherwise the fixed R target. The breakdown table scores each kind of target separately.", group=G_TR)
fixR     = input.float(3.0, "Fixed R target", minval=0.5, step=0.5, group=G_TR)
maxRisk  = input.float(40.0, "Max stop size (points, 0 = off)", minval=0, step=1, group=G_TR)
confWin  = input.int(6, "Confirmation: 5m candles allowed", minval=1, maxval=48, tooltip="How many entry-timeframe candles after the RB the confirmation close may take. It is also cancelled if price trades through the stop first.", group=G_TR)
maxRRin  = input.float(0.0, "Skip targets further than (R, 0 = off)", minval=0, step=1, tooltip="A target this many R away or more is rarely reached before the stop. The breakdown shows results by target distance.", group=G_TR)
limMin   = input.int(60, "Sweep limits cancel after (minutes)", minval=1, maxval=1440, group=G_TR)
tp1R     = input.float(1.0, "TP1 for ½ + breakeven (R)", minval=0.25, step=0.25, group=G_TR)
mgmt     = input.string("Full to target", "Results use", options=["Full to target", "½ at TP1 + breakeven"], tooltip="Which result the chart labels, breakdown, daily log and alerts use (A6). The entry rows show both.", group=G_TR)
flatIn   = input.string("16:00 NY", "Flatten & cancel at", options=["16:00 NY", "17:00 NY (close)", "Never"], group=G_TR)
riskUsd  = input.float(0.0, "Risk per trade ($) for a contract count (0 = off)", minval=0, step=50, group=G_TR)

colBull = input.color(#26a69a, "Bullish 5m RB", inline="c1", group=G_VIS)
colBear = input.color(#ef5350, "Bearish 5m RB", inline="c1", group=G_VIS)
colTgt  = input.color(#ffffff, "Target RB", inline="c2", group=G_VIS)
colEnt  = input.color(#2962ff, "Entry", inline="c3", group=G_VIS)
colTp   = input.color(#26a69a, "TP", inline="c3", group=G_VIS)
colSl   = input.color(#ef5350, "SL", inline="c3", group=G_VIS)
tagMode = input.string("Live trade only", "Entry / TP / SL tags", options=["All trades", "Live trade only", "Off"], tooltip="Price lines with a tag at the right: BUY/SELL price, TP price and R, SL price and points. A finished trade's tag shows ✓ HIT or ✗ HIT and its result.", group=G_VIS)
tagSz   = input.string("Normal", "Tag size", options=["Small", "Normal", "Large"], group=G_VIS)
showSkip = input.bool(false, "Show skipped setups (grey ✕)", tooltip="Setups the shown entry didn't trade. Hover the ✕ for the reason.", group=G_VIS)
lblMode = input.string("Compact", "Signal labels", options=["Compact", "Full", "Off"], tooltip="Compact = BUY / SELL and the entry price. Full adds the setup and level. Hover a label for every detail.", group=G_VIS)
tgtDraw = input.string("Targets only", "Draw target RBs", options=["Targets only", "Off"], tooltip="The white box of each trade's target RB. JS RB draws the others.", group=G_VIS)
maxDraw = input.int(40, "Signals kept on the chart", minval=1, maxval=100, group=G_VIS)

tblMode  = input.string("Compact", "Stats table", options=["Compact", "Breakdown", "Days", "Off"], tooltip="Compact = the four entries compared. Breakdown splits the shown entry's trades by setup, side, level, session, target and more. Days = the last 10 trading days.", group=G_ST)
statsPos = input.string("Top Right", "Table position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group=G_ST)

// ============================= CONSTANTS =====================================
NY      = "America/New_York"
TICK    = na(syminfo.mintick) or syminfo.mintick <= 0 ? 0.25 : syminfo.mintick
PV      = na(syminfo.pointvalue) or syminfo.pointvalue <= 0 ? 1.0 : syminfo.pointvalue
MAX_AGE = 4500

tfOf(string s) =>
    switch s
        "1m"  => "1"
        "3m"  => "3"
        "5m"  => "5"
        "15m" => "15"
        "30m" => "30"
        "1H"  => "60"
        "2H"  => "120"
        "4H"  => "240"
        => "5"

entTf = tfOf(entTfIn)
tgtTf = tfOf(tgtTfIn)
if barstate.isfirst
    int cs = timeframe.in_seconds()
    if timeframe.in_seconds(entTf) < cs or timeframe.in_seconds(entTf) % cs != 0
        runtime.error("Use a chart timeframe that divides the entry RB timeframe, e.g. a 1m chart for 5m RBs.")
    if timeframe.in_seconds(tgtTf) <= timeframe.in_seconds(entTf)
        runtime.error("The target RB timeframe must be above the entry RB timeframe.")

selIdx   = entrySel == "RB close (market)" ? 0 : entrySel == "Body-edge limit" ? 1 : entrySel == "CE limit" ? 2 : 3
useM     = mgmt == "½ at TP1 + breakeven"
tpCe     = tpAt == "CE (50%)"
useNext  = closeTgt == "Use the next one out"
pivN     = strengthIn == "Normal" ? 3 : strengthIn == "Strict" ? 6 : 1   // candles to the right, as JS RB
pivL     = strengthIn == "Normal" ? 2 : pivN                              // candles to the left
tgtFull  = tgtSrc == "Full history (like JS RB)"
noTgtMode = noTgtIn == "Skip the trade" ? 2 : noTgtIn == "Fixed R target" ? 1 : 0
TAG_SZ   = tagSz == "Small" ? size.small : tagSz == "Large" ? size.large : size.normal
tagsOn   = tagMode != "Off"
limBars  = math.max(1, math.round(limMin * 60.0 / timeframe.in_seconds()))
bkTbl    = tblMode == "Breakdown"
dayTbl   = tblMode == "Days"

// ============================== STATE ========================================
var State       S    = State.new()
var Agg         aE   = Agg.new(hb=array.new<float>(), lb=array.new<float>(), hs=array.new<float>(), ls=array.new<float>(), ho=array.new<float>(), hc=array.new<float>())
var Agg         aT   = Agg.new(hb=array.new<float>(), lb=array.new<float>(), hs=array.new<float>(), ls=array.new<float>(), ho=array.new<float>(), hc=array.new<float>())
var Agg         a4   = Agg.new(hb=array.new<float>(), lb=array.new<float>(), hs=array.new<float>(), ls=array.new<float>(), ho=array.new<float>(), hc=array.new<float>())
var array<Lvl>  lvls = array.new<Lvl>()
var array<Zone> pool = array.new<Zone>()   // live target-timeframe RBs (R5)
var array<Zone> c5   = array.new<Zone>()   // recent entry-timeframe RBs, for the 4H RB setup (R4)
var array<Sig>  sigs = array.new<Sig>()

// per entry (0 market, 1 edge, 2 CE): valid trades, fills, target hits, full / managed R
var array<int>   eValid = array.new<int>(4, 0)
var array<int>   eFill  = array.new<int>(4, 0)
var array<int>   eHit   = array.new<int>(4, 0)
var array<float> eSumF  = array.new<float>(4, 0.0)
var array<float> eSumM  = array.new<float>(4, 0.0)
var array<int>   eWinM  = array.new<int>(4, 0)
// breakdown of the shown entry
BK_N = 24
var array<int>   bN   = array.new<int>(BK_N, 0)
var array<int>   bW   = array.new<int>(BK_N, 0)
var array<float> bSum = array.new<float>(BK_N, 0.0)
// daily log of the shown entry
var array<int>    dKey  = array.new<int>()
var array<string> dName = array.new<string>()
var array<int>    dN    = array.new<int>()
var array<int>    dW    = array.new<int>()
var array<float>  dR    = array.new<float>()

// trading day and period ranges
var int    koDay   = 0
var string dayName = ""
var bool   sawEve  = false
var float  dH      = na
var float  dOpen   = na      // the daily (18:00) open, for premium / discount
var float  dL      = na
var int    dCnt    = -99     // trading days into the week; 1 = Monday's
var bool   dOk     = false   // a full day / week / month has been seen
var bool   wOk     = false
var bool   mOk     = false
var float  wH      = na
var float  wL      = na
var float  mH      = na
var float  mL      = na
var float  asH     = na
var float  asL     = na
var float  lnH     = na
var float  lnL     = na
var bool   wasAs   = false
var bool   wasLn   = false

// ============================== HELPERS ======================================
nyMin(int t) =>
    hour(t, NY) * 60 + minute(t, NY)

px(float p) =>
    str.tostring(p, format.mintick)

fmtR(float r) =>
    (r > 0 ? "+" : "") + str.tostring(r, "0.0") + "R"

f_pct(int a, int b) =>
    b > 0 ? str.tostring(math.round(100.0 * a / b)) + "%" : "-"

// A1: one chart bar into a candle builder; returns up to two finished candles
aggStep(Agg a, bool isNew, bool isLast) =>
    Candle c1 = na
    Candle c2 = na
    if isNew
        if not a.done and not na(a.o)
            c1 := Candle.new(a.o, a.h, a.l, a.c, a.t, a.b, bar_index, true)
        a.o := open
        a.h := high
        a.l := low
        a.c := close
        a.t := time
        a.b := bar_index
        a.done := false
    else if not na(a.o)
        a.h := math.max(a.h, high)
        a.l := math.min(a.l, low)
        a.c := close
    if isLast and not a.done and not na(a.o)
        c2 := Candle.new(a.o, a.h, a.l, a.c, a.t, a.b, bar_index, false)
        a.done := true
    [c1, c2]

// R1, JS RB's rule on one finished candle: confirm the swing high/low that is now
// pivN candles old, then take every swing level this candle's wick trades through.
// Returns [bearish RBs, bullish RBs] (one per level taken with the body on the near side).
jsStep(Agg a, Candle k) =>
    int w = pivN + pivL + 1
    a.hb.push(k.h)
    a.lb.push(k.l)
    if a.hb.size() > w
        a.hb.shift()
        a.lb.shift()
    if a.hb.size() == w
        float ph = a.hb.get(pivL)
        float pl = a.lb.get(pivL)
        bool isH = true
        bool isL = true
        for i = 0 to w - 1
            if i != pivL
                if a.hb.get(i) >= ph
                    isH := false
                if a.lb.get(i) <= pl
                    isL := false
        if isH
            a.hs.push(ph)
            if a.hs.size() > 500
                a.hs.shift()
        if isL
            a.ls.push(pl)
            if a.ls.size() > 500
                a.ls.shift()
    float bt = math.max(k.o, k.c)
    float bb = math.min(k.o, k.c)
    int nb = 0
    int nu = 0
    if a.hs.size() > 0
        for i = a.hs.size() - 1 to 0
            float lv = a.hs.get(i)
            if k.h > lv
                if bt < lv
                    nb += 1
                a.hs.remove(i)
    if a.ls.size() > 0
        for i = a.ls.size() - 1 to 0
            float lv = a.ls.get(i)
            if k.l < lv
                if bb > lv
                    nu += 1
                a.ls.remove(i)
    if dirOnly
        nb := k.c < k.o ? nb : 0
        nu := k.c > k.o ? nu : 0
    [nb, nu]

// R5: JS RB's target-timeframe RBs over that timeframe's own full history (JS RB's
// htfZoneArrays, run through request.security). Returns the live zones.
jsZonesHTF() =>
    var array<float> hs = array.new<float>()
    var array<float> ls = array.new<float>()
    var array<float> bT = array.new<float>()
    var array<float> bB = array.new<float>()
    var array<int>   bX = array.new<int>()
    var array<float> uT = array.new<float>()
    var array<float> uB = array.new<float>()
    var array<int>   uX = array.new<int>()
    if bT.size() > 0
        for i = bT.size() - 1 to 0
            if high > bT.get(i)
                bT.remove(i)
                bB.remove(i)
                bX.remove(i)
    if uT.size() > 0
        for i = uT.size() - 1 to 0
            if low < uB.get(i)
                uT.remove(i)
                uB.remove(i)
                uX.remove(i)
    if bar_index >= pivL + pivN
        float ph = high[pivN]
        float pl = low[pivN]
        bool isH = true
        bool isL = true
        for k = 0 to pivN + pivL
            if k != pivN
                if high[k] >= ph
                    isH := false
                if low[k] <= pl
                    isL := false
        if isH
            hs.push(ph)
            if hs.size() > 500
                hs.shift()
        if isL
            ls.push(pl)
            if ls.size() > 500
                ls.shift()
    float bt = math.max(open, close)
    float bb = math.min(open, close)
    int nb = 0
    int nu = 0
    if hs.size() > 0
        for i = hs.size() - 1 to 0
            float lv = hs.get(i)
            if high > lv
                if bt < lv
                    nb += 1
                hs.remove(i)
    if ls.size() > 0
        for i = ls.size() - 1 to 0
            float lv = ls.get(i)
            if low < lv
                if bb > lv
                    nu += 1
                ls.remove(i)
    if dirOnly
        nb := close < open ? nb : 0
        nu := close > open ? nu : 0
    if barstate.isconfirmed
        if nb > 0
            bT.push(high)
            bB.push(bt)
            bX.push(time)
            if bT.size() > 500
                bT.shift()
                bB.shift()
                bX.shift()
        if nu > 0
            uT.push(bb)
            uB.push(low)
            uX.push(time)
            if uT.size() > 500
                uT.shift()
                uB.shift()
                uX.shift()
    [array.copy(bT), array.copy(bB), array.copy(bX), array.copy(uT), array.copy(uB), array.copy(uX)]

zoneOf(Candle k, bool bull) =>
    float tip  = bull ? k.l : k.h
    float edge = bull ? math.min(k.o, k.c) : math.max(k.o, k.c)
    Zone.new(bull=bull, tip=tip, edge=edge, ce=(tip + edge) / 2, formT=k.t, formBar=k.b, endBar=k.e, cls=k.c, dirC=bull ? k.c > k.o : k.c < k.o)

// keep the last candles' opens and closes for the CISD level
remember(Agg a, Candle k) =>
    a.ho.push(k.o)
    a.hc.push(k.c)
    if a.ho.size() > 12
        a.ho.shift()
        a.hc.shift()
    true

// R7: CISD level = open of the first candle in the unbroken run of candles that closed
// toward the wick and pushed into the RB (the RB candle included when it closed that
// way). With no such run, the RB candle's far extreme.
cisdOf(Agg a, Candle k, bool bull) =>
    float runOpen = (bull ? k.c < k.o : k.c > k.o) ? k.o : na
    int j = a.ho.size() - 1
    int steps = 0
    while j >= 0 and steps < 10
        float oj = a.ho.get(j)
        float cj = a.hc.get(j)
        if bull ? cj < oj : cj > oj
            runOpen := oj
            j -= 1
            steps += 1
        else
            break
    na(runOpen) ? (bull ? k.h : k.l) : runOpen

// premium / discount against the daily open
pdOf(bool bull, Zone z) =>
    not na(dOpen) and (bull ? z.ce < dOpen : z.ce > dOpen)

// R2: a level is born; an older level of the same name is replaced
addLvl(float p, string n, int side, int grp, int bt) =>
    if not na(p)
        for lv in lvls
            if lv.name == n and na(lv.deadT)
                lv.deadT := bt
        array.push(lvls, Lvl.new(price=p, name=n, side=side, grp=grp, bornT=bt))
    true

// R3: the levels a 5m RB's wick rejected
sweptBy(Candle k, bool bull) =>
    array<Lvl> hits = array.new<Lvl>()
    float bt = math.max(k.o, k.c)
    float bb = math.min(k.o, k.c)
    for lv in lvls
        bool alive = lv.bornT <= k.t and (na(lv.deadT) or k.t < lv.deadT) and not lv.broken
        bool sideOk = bull ? lv.side <= 0 : lv.side >= 0
        bool unused = not oncePer or not (bull ? lv.usedBull : lv.usedBear)
        if alive and sideOk and unused
            if bull ? k.l <= lv.price + tolTk * TICK and bb > lv.price : k.h >= lv.price - tolTk * TICK and bt < lv.price
                array.push(hits, lv)
    hits

// R5/R6: [target price, target RB, reason when there is none, kind, name].
// Kind 0 = the nearest live opposing target-timeframe RB; when none is far enough,
// 1 = the opposite previous-4H high/low, 2 = a fixed R target (input).
pickTgt(bool bull, float e, float rk) =>
    Zone  best  = na
    float bestP = na
    bool  near  = false
    for z in pool
        if z.fresh and z.bull != bull
            float p = tpCe ? z.ce : z.edge
            if bull ? p > e : p < e
                bool okRR = math.abs(p - e) >= minRR * rk
                near := near or not okRR
                if (okRR or not useNext) and (na(bestP) or (bull ? p < bestP : p > bestP))
                    best := z
                    bestP := p
    string why  = ""
    int    kind = 0
    string name = tgtTfIn + " RB"
    if not na(bestP) and math.abs(bestP - e) < minRR * rk
        why := "Nearest " + tgtTfIn + " RB is closer than " + str.tostring(minRR) + "R"
        bestP := na
        best := na
    else if na(bestP)
        if noTgtMode == 2
            why := near ? "Every " + tgtTfIn + " RB beyond the entry is closer than " + str.tostring(minRR) + "R" : "No live " + tgtTfIn + " RB beyond the entry"
        else
            if noTgtMode == 0
                for lv in lvls
                    if lv.grp == 0 and lv.side == (bull ? 1 : -1) and na(lv.deadT) and not lv.broken and (bull ? lv.price > e : lv.price < e) and math.abs(lv.price - e) >= minRR * rk
                        bestP := lv.price
                        kind := 1
                        name := lv.name
            if na(bestP)
                bestP := bull ? e + fixR * rk : e - fixR * rk
                kind := 2
                name := "fixed " + str.tostring(fixR) + "R"
    [bestP, best, why, kind, name]

// set a trade's entry, risk and target; a market trade fills now
arm(Trade t, bool bull, float e) =>
    t.entry := e
    t.wait := false
    t.valid := false
    float rk = bull ? e - t.stop : t.stop - e
    t.risk := rk
    if rk <= 0
        t.why := "No room for a stop"
    else if maxRisk > 0 and rk > maxRisk
        t.why := "Stop " + str.tostring(rk, "0.00") + " pts > max " + str.tostring(maxRisk)
    else
        [p, z, why, kind, name] = pickTgt(bull, e, rk)
        if na(p)
            t.why := why
        else if maxRRin > 0 and math.abs(p - e) / rk > maxRRin
            t.why := "Target " + str.tostring(math.abs(p - e) / rk, "0.0") + "R away > max " + str.tostring(maxRRin) + "R"
        else
            t.valid := true
            t.tgt := p
            t.tz := z
            t.kind := kind
            t.tgtName := name
            t.rr := math.abs(p - e) / rk
            t.tp1 := bull ? e + tp1R * rk : e - tp1R * rk
            if t.mkt
                t.filled := true
                t.fillBar := bar_index
    if not t.valid
        t.cancelled := true
    t

mkTrade(bool bull, float e, float stop, bool mkt) =>
    arm(Trade.new(stop=stop, mkt=mkt), bull, e)

selT(Sig s) =>
    selIdx == 0 ? s.t0 : selIdx == 1 ? s.t1 : selIdx == 2 ? s.t2 : s.t3

tradeAt(Sig s, int m) =>
    m == 0 ? s.t0 : m == 1 ? s.t1 : m == 2 ? s.t2 : s.t3

isOver(Trade t) =>
    t.cancelled or (t.doneF and t.doneM)

// the shown result of a trade is still running
isLive(Trade t) =>
    t.valid and not t.cancelled and not (useM ? t.doneM : t.doneF)

// A3/A4/A5/A6: one bar of one trade. Returns [filled now, finished now, cancelled now].
stepTrade(Trade t, bool bull, bool expireNow, bool flat) =>
    bool fNow = false
    bool dNow = false
    bool cNow = false
    if t.wait
        if flat or (bull ? low <= t.stop : high >= t.stop)
            t.wait := false
            t.cancelled := true
            t.why := flat ? "Flatten time before the confirmation" : "Price traded through the stop before the confirmation"
            cNow := true
    else if t.valid and not isOver(t)
        if not t.filled
            if expireNow or flat
                t.cancelled := true
                t.why := flat ? "Flatten time before filling" : "Limit expired"
                cNow := true
            else if bull ? low <= t.entry : high >= t.entry
                t.filled := true
                t.fillBar := bar_index
                fNow := true
            else if bull ? high >= t.tgt : low <= t.tgt
                t.cancelled := true
                t.why := "Ran to the target before filling"
                cNow := true
        if t.filled
            bool  after = bar_index > t.fillBar
            bool  stopH = (after or not t.mkt) and (bull ? low <= t.stop : high >= t.stop)
            bool  tgtH  = after and (bull ? high >= t.tgt : low <= t.tgt)
            bool  tp1H  = after and (bull ? high >= t.tp1 : low <= t.tp1)
            float half  = t.rr > tp1R ? 0.5 : 0.0
            if not t.doneF
                if stopH
                    t.r := -1.0
                    t.doneF := true
                    t.exitF := bar_index
                    t.pxF := t.stop
                else if tgtH
                    t.r := t.rr
                    t.hit := true
                    t.doneF := true
                    t.exitF := bar_index
                    t.pxF := t.tgt
            if not t.doneM
                if not t.t1Hit
                    if stopH
                        t.rM := -1.0
                        t.doneM := true
                        t.exitM := bar_index
                        t.pxM := t.stop
                    else if half > 0 and tp1H
                        t.t1Hit := true
                        t.t1Bar := bar_index
                        if tgtH
                            t.rM := half * tp1R + (1 - half) * t.rr
                            t.doneM := true
                            t.exitM := bar_index
                            t.pxM := t.tgt
                    else if tgtH
                        t.rM := t.rr
                        t.doneM := true
                        t.exitM := bar_index
                        t.pxM := t.tgt
                else if bar_index > t.t1Bar and (bull ? low <= t.entry : high >= t.entry)
                    t.rM := half * tp1R
                    t.doneM := true
                    t.exitM := bar_index
                    t.pxM := t.entry
                else if tgtH
                    t.rM := half * tp1R + (1 - half) * t.rr
                    t.doneM := true
                    t.exitM := bar_index
                    t.pxM := t.tgt
            if flat
                float rNow = (bull ? close - t.entry : t.entry - close) / t.risk
                if not t.doneF
                    t.r := rNow
                    t.doneF := true
                    t.exitF := bar_index
                    t.pxF := close
                if not t.doneM
                    t.rM := t.t1Hit ? 0.5 * tp1R + 0.5 * rNow : rNow
                    t.doneM := true
                    t.exitM := bar_index
                    t.pxM := close
            dNow := t.doneF and t.doneM
    [fNow, dNow, cNow]

// ---- text ----
dirTxt(Sig s) =>
    s.bull ? "BUY" : "SELL"

setupTxt(Sig s) =>
    s.setup == "Sweep" ? "Sweep of " + s.names : s.names

ctsTxt(Trade t) =>
    string res = ""
    if riskUsd > 0 and t.risk > 0
        int n = math.floor(riskUsd / (t.risk * PV))
        res := n >= 1 ? "\nSize: " + str.tostring(n) + " contracts for $" + str.tostring(riskUsd) : "\nSize: 1 contract risks more than $" + str.tostring(riskUsd)
    res

tgtTxt(Trade t) =>
    t.kind == 0 and not na(t.tz) ? px(t.tgt) + " (" + tgtTfIn + " RB " + px(math.min(t.tz.tip, t.tz.edge)) + " – " + px(math.max(t.tz.tip, t.tz.edge)) + ")" : px(t.tgt) + " (" + t.tgtName + ")"

entryName(Sig s, int m) =>
    m == 0 ? (s.setup == "Sweep" ? "RB close (market)" : "4H close (market)") : m == 1 ? "Body-edge limit" : m == 2 ? "CE limit" : "Confirmation close"

lblTxt(Sig s, Trade t) =>
    string base = t.wait ? dirTxt(s) + " · wait" : tagsOn ? dirTxt(s) + (t.mkt ? "" : " LMT") : dirTxt(s) + (t.mkt ? " " : " LMT ") + px(t.entry)
    lblMode == "Full" ? base + "\n" + setupTxt(s) : base

tagTxtE(Sig s, Trade t) =>
    dirTxt(s) + (t.filled ? " " : " LIMIT ") + px(t.entry)

tagTxtT(Trade t) =>
    "TP " + px(t.tgt) + "   +" + str.tostring(t.rr, "0.0") + "R · " + t.tgtName

tagTxtS(Trade t) =>
    "SL " + px(t.stop) + "   −1R · " + str.tostring(t.risk, "0.00") + " pts"

sigTip(Sig s, Trade t) =>
    t.wait ? dirTxt(s) + " · " + setupTxt(s) + "\nWaiting for a 5m close " + (s.bull ? "above " : "below ") + px(t.cisd) + " (CISD), then enter at that close\nStop: " + px(t.stop) + "\n5m RB: " + px(math.min(s.rb.tip, s.rb.edge)) + " – " + px(math.max(s.rb.tip, s.rb.edge)) : dirTxt(s) + " · " + setupTxt(s) + "\n" + entryName(s, selIdx) + ": " + px(t.entry) + "\nStop: " + px(t.stop) + " (" + str.tostring(t.risk, "0.00") + " pts)\nTarget: " + tgtTxt(t) + "\nR:R " + str.tostring(t.rr, "0.0") + ctsTxt(t) + "\n5m RB: " + px(math.min(s.rb.tip, s.rb.edge)) + " – " + px(math.max(s.rb.tip, s.rb.edge)) + " · CE " + px(s.rb.ce) + (t.why != "" ? "\n" + t.why : "")

// ---- drawing ----
// the shown trade's TP / SL zones, price lines and tags, and its target box
drawPos(Sig s) =>
    Trade t = selT(s)
    int x0 = bar_index
    s.tpBx := box.new(x0, math.max(t.entry, t.tgt), x0 + 1, math.min(t.entry, t.tgt), border_color=color.new(colTp, 100), bgcolor=color.new(colTp, 85))
    s.slBx := box.new(x0, math.max(t.entry, t.stop), x0 + 1, math.min(t.entry, t.stop), border_color=color.new(colSl, 100), bgcolor=color.new(colSl, 85))
    if tagsOn
        string st = t.filled ? line.style_solid : line.style_dashed
        s.lnE := line.new(x0, t.entry, x0 + 1, t.entry, color=colEnt, width=2, style=st)
        s.lnT := line.new(x0, t.tgt, x0 + 1, t.tgt, color=colTp, width=2, style=st)
        s.lnS := line.new(x0, t.stop, x0 + 1, t.stop, color=colSl, width=2, style=st)
        s.tgE := label.new(x0 + 1, t.entry, tagTxtE(s, t), style=label.style_label_left, color=colEnt, textcolor=color.white, size=TAG_SZ, tooltip=sigTip(s, t))
        s.tgT := label.new(x0 + 1, t.tgt, tagTxtT(t), style=label.style_label_left, color=colTp, textcolor=color.white, size=TAG_SZ, tooltip=sigTip(s, t))
        s.tgS := label.new(x0 + 1, t.stop, tagTxtS(t), style=label.style_label_left, color=colSl, textcolor=color.white, size=TAG_SZ, tooltip=sigTip(s, t))
    if tgtDraw == "Targets only" and not na(t.tz)
        s.tzBx := box.new(t.tz.formT, math.max(t.tz.tip, t.tz.edge), time, math.min(t.tz.tip, t.tz.edge), xloc=xloc.bar_time, border_color=color.new(colTgt, 10), bgcolor=color.new(colTgt, 90), text=tgtTfIn, text_size=size.tiny, text_color=colTgt, text_halign=text.align_right)
    true

drawSig(Sig s) =>
    Trade t = selT(s)
    color c = s.bull ? colBull : colBear
    s.rbBx := box.new(math.max(s.rb.formBar, bar_index - MAX_AGE), math.max(s.rb.tip, s.rb.edge), bar_index, math.min(s.rb.tip, s.rb.edge), border_color=color.new(c, 20), bgcolor=color.new(c, 80))
    if not t.wait
        drawPos(s)
    if lblMode != "Off"
        s.lb := label.new(s.sigBar, s.rb.tip, lblTxt(s, t), style=s.bull ? label.style_label_up : label.style_label_down, color=c, textcolor=color.white, size=size.small, tooltip=sigTip(s, t))
    s.drawn := true
    true

// a setup the shown entry didn't trade: a grey ✕ with the reason
drawSkip(Sig s) =>
    Trade t = selT(s)
    color g = color.gray
    s.rbBx := box.new(math.max(s.rb.formBar, bar_index - MAX_AGE), math.max(s.rb.tip, s.rb.edge), bar_index, math.min(s.rb.tip, s.rb.edge), border_color=color.new(g, 40), bgcolor=color.new(g, 85))
    if lblMode != "Off"
        s.lb := label.new(s.sigBar, s.rb.tip, dirTxt(s) + " ✕", style=s.bull ? label.style_label_up : label.style_label_down, color=color.new(g, 40), textcolor=color.white, size=size.small, tooltip=dirTxt(s) + " · " + setupTxt(s) + "\nSkipped: " + t.why + "\n5m RB: " + px(math.min(s.rb.tip, s.rb.edge)) + " – " + px(math.max(s.rb.tip, s.rb.edge)))
    s.drawn := true
    true

setRight(box b, int x) =>
    if not na(b)
        box.set_right(b, x)
    true

delTags(Sig s) =>
    line.delete(s.lnE)
    line.delete(s.lnT)
    line.delete(s.lnS)
    label.delete(s.tgE)
    label.delete(s.tgT)
    label.delete(s.tgS)
    s.lnE := na
    s.lnT := na
    s.lnS := na
    s.tgE := na
    s.tgT := na
    s.tgS := na
    true

// move the right end of a signal's drawings to bar x
moveEnd(Sig s, int x) =>
    setRight(s.rbBx, x)
    setRight(s.tpBx, x)
    setRight(s.slBx, x)
    // the target box is in bar time; x is always the current bar here
    if not na(s.tzBx)
        box.set_right(s.tzBx, time)
    if not na(s.lnE)
        line.set_x2(s.lnE, x)
        line.set_x2(s.lnT, x)
        line.set_x2(s.lnS, x)
    if not na(s.tgE)
        label.set_x(s.tgE, x)
        label.set_x(s.tgT, x)
        label.set_x(s.tgS, x)
    true

extendSig(Sig s) =>
    moveEnd(s, bar_index)

// the shown trade finished: freeze its drawings at the exit and print the result
finishSig(Sig s) =>
    Trade t = selT(s)
    int   xb = useM ? t.exitM : t.exitF
    float xp = useM ? t.pxM : t.pxF
    float r  = useM ? t.rM : t.r
    moveEnd(s, xb)
    if not na(s.tpBx)
        box.set_bgcolor(s.tpBx, color.new(colTp, r > 0 ? 75 : 93))
    if not na(s.slBx)
        box.set_bgcolor(s.slBx, color.new(colSl, r < 0 ? 75 : 93))
    string tip = dirTxt(s) + " " + setupTxt(s) + "\nEntry " + px(t.entry) + " → exit " + px(xp) + "\nFull to target: " + fmtR(t.r) + " · ½ at TP1 + BE: " + fmtR(t.rM)
    if tagMode == "Live trade only"
        delTags(s)
    // the exit's own tag carries the result; an exit anywhere else gets its own label
    label hitTag = na(s.tgE) ? na : xp == t.tgt ? s.tgT : xp == t.stop ? s.tgS : xp == t.entry ? s.tgE : na
    if not na(hitTag)
        label.set_text(hitTag, label.get_text(hitTag) + "   " + (r > 0 ? "✓" : r < 0 ? "✗" : "■") + " HIT " + fmtR(r))
        label.set_tooltip(hitTag, tip)
    else
        color rc = r > 0 ? colTp : r < 0 ? colSl : color.gray
        bool atLvl = xp == t.tgt or xp == t.stop or xp == t.entry
        s.res := label.new(xb, xp, fmtR(r) + (atLvl ? "" : " flattened"), style=label.style_label_left, color=rc, textcolor=color.white, size=size.small, tooltip=tip)
    true

// the shown limit never filled
cancelSig(Sig s) =>
    Trade t = selT(s)
    box.delete(s.tpBx)
    box.delete(s.slBx)
    box.delete(s.tzBx)
    s.tpBx := na
    s.slBx := na
    s.tzBx := na
    delTags(s)
    setRight(s.rbBx, bar_index)
    if not na(s.rbBx)
        box.set_bgcolor(s.rbBx, color.new(s.bull ? colBull : colBear, 92))
    if not na(s.lb)
        label.set_text(s.lb, label.get_text(s.lb) + " ✕")
        label.set_tooltip(s.lb, sigTip(s, t))
        label.set_color(s.lb, color.new(color.gray, 40))
    true

delSig(Sig s) =>
    box.delete(s.rbBx)
    box.delete(s.tpBx)
    box.delete(s.slBx)
    box.delete(s.tzBx)
    label.delete(s.lb)
    label.delete(s.res)
    delTags(s)
    s.drawn := false
    true

// A7: may a new signal in this direction start now?
canSignal(bool bull, bool blk) =>
    bool ok = not blk and (dirIn == "Both" or (bull ? dirIn == "Longs only" : dirIn == "Shorts only"))
    if ok and overlap != "Take every signal"
        for s in sigs
            if not s.resolved and isLive(selT(s)) and (overlap == "One at a time" or s.bull == bull)
                ok := false
    ok

mkSig(Zone z, bool bull, string setup, string names, int grp, float mktPx) =>
    float stop = bull ? z.tip - stopTk * TICK : z.tip + stopTk * TICK
    Trade t0 = mkTrade(bull, mktPx, stop, true)
    Trade t1 = mkTrade(bull, z.edge, stop, false)
    Trade t2 = mkTrade(bull, z.ce, stop, false)
    // R7: the confirmation entry waits for a close through the CISD level, unless the RB candle already closed there
    Trade t3 = Trade.new(stop=stop, mkt=true)
    if bull ? mktPx > z.cisd : mktPx < z.cisd
        arm(t3, bull, mktPx)
    else
        t3.wait := true
        t3.valid := true
        t3.cisd := z.cisd
    int m = nyMin(time)
    int tb = m >= 1080 or m < 120 ? 0 : m < 510 ? 1 : m < 720 ? 2 : 3
    Sig s = Sig.new(bull=bull, setup=setup, names=names, grp=grp, tb=tb, rb=z, sigBar=bar_index, sigT=time, day=koDay, dayName=dayName, n4hAt=S.n4h, t0=t0, t1=t1, t2=t2, t3=t3, fPd=pdOf(bull, z))
    array.push(sigs, s)
    S.setups += 1
    if not selT(s).valid
        S.noTgt += 1
    s

// A6/A8: add a finished signal to the stats and the daily log
countSig(Sig s) =>
    for m = 0 to 3
        Trade t = tradeAt(s, m)
        if t.valid
            array.set(eValid, m, array.get(eValid, m) + 1)
        if t.filled
            array.set(eFill, m, array.get(eFill, m) + 1)
            array.set(eHit, m, array.get(eHit, m) + (t.hit ? 1 : 0))
            array.set(eSumF, m, array.get(eSumF, m) + t.r)
            array.set(eSumM, m, array.get(eSumM, m) + t.rM)
            array.set(eWinM, m, array.get(eWinM, m) + (t.rM > 0 ? 1 : 0))
    Trade ts = selT(s)
    if ts.filled
        float r = useM ? ts.rM : ts.r
        for k = 0 to BK_N - 1
            bool inRow = switch k
                0  => s.setup == "Sweep"
                1  => s.setup == "4H RB"
                2  => s.bull
                3  => not s.bull
                4  => s.grp == 0
                5  => s.grp == 1
                6  => s.grp == 2
                7  => s.grp == 3
                8  => s.tb == 0
                9  => s.tb == 1
                10 => s.tb == 2
                11 => s.tb == 3
                12 => ts.kind == 0
                13 => ts.kind == 1
                14 => ts.kind == 2
                15 => s.fPd
                16 => not s.fPd
                17 => s.rb.dirC
                18 => not s.rb.dirC
                19 => ts.rr < 5
                20 => ts.rr >= 5 and ts.rr <= 10
                21 => ts.rr > 10
                22 => ts.risk <= 15
                => ts.risk > 15
            if inRow
                array.set(bN, k, array.get(bN, k) + 1)
                array.set(bW, k, array.get(bW, k) + (r > 0 ? 1 : 0))
                array.set(bSum, k, array.get(bSum, k) + r)
        S.eq += r
        S.peak := math.max(S.peak, S.eq)
        S.maxDD := math.max(S.maxDD, S.peak - S.eq)
        if r < 0
            S.lose += 1
            S.maxLose := math.max(S.maxLose, S.lose)
        else if r > 0
            S.lose := 0
        // daily log, kept in day order
        int idx = -1
        int ins = 0
        int nD = array.size(dKey)
        if nD > 0
            for i = nD - 1 to 0
                int key = array.get(dKey, i)
                if key == s.day
                    idx := i
                    break
                if key < s.day
                    ins := i + 1
                    break
        if idx < 0
            array.insert(dKey, ins, s.day)
            array.insert(dName, ins, s.dayName)
            array.insert(dN, ins, 0)
            array.insert(dW, ins, 0)
            array.insert(dR, ins, 0.0)
            idx := ins
        array.set(dN, idx, array.get(dN, idx) + 1)
        array.set(dW, idx, array.get(dW, idx) + (r > 0 ? 1 : 0))
        array.set(dR, idx, array.get(dR, idx) + r)
        if array.size(dKey) > 400
            array.shift(dKey)
            array.shift(dName)
            array.shift(dN)
            array.shift(dW)
            array.shift(dR)
        log.info(s.dayName + " · " + dirTxt(s) + " · " + setupTxt(s) + " · " + entryName(s, selIdx) + " " + px(ts.entry) + " · SL " + px(ts.stop) + " · TP " + px(ts.tgt) + " (" + ts.tgtName + ") · " + fmtR(r) + " (full " + fmtR(ts.r) + ", ½+BE " + fmtR(ts.rM) + ")")
    true

// ---- per-bar context. Called every bar so their state stays consistent; used on confirmed bars only.
bool eNew     = entTf == timeframe.period or timeframe.change(entTf)
bool eLast    = entTf == timeframe.period or time_close == time_close(entTf)
bool tNew     = tgtTf == timeframe.period or timeframe.change(tgtTf)
bool tLast    = tgtTf == timeframe.period or time_close == time_close(tgtTf)
bool fNew     = timeframe.change("240")
bool fLast    = time_close == time_close("240")
bool newDay   = timeframe.change("D")
bool newWeek  = timeframe.change("W")
bool newMonth = timeframe.change("M")
bool newQtr   = timeframe.change("3M")
bool newYear  = timeframe.change("12M")
int  mNow     = nyMin(time)
int  mCls     = na(time_close) ? na : nyMin(time_close)
int  mPrv     = mNow[1]
bool cross18  = not na(mPrv) and mNow >= 1080 and (mPrv < 1080 or time - time[1] >= 43200000)
int  flatMin  = flatIn == "16:00 NY" ? 960 : flatIn == "17:00 NY (close)" ? 1020 : na
bool flatNow  = not na(flatMin) and not na(mCls) and mNow < flatMin and mCls >= flatMin
bool quiet    = not na(flatMin) and mNow >= flatMin and mNow < 1080
bool inWin    = not useWin or not na(time(timeframe.period, winSess, NY))
bool inAs     = useAsia and not na(time(timeframe.period, asiaSes, NY))
bool inLn     = useLon and not na(time(timeframe.period, lonSes, NY))
bool blocked  = flatNow or quiet or not inWin

// R5: the target-timeframe RBs as JS RB builds them, over that timeframe's full history
[zbT, zbB, zbX, zuT, zuB, zuX] = if tgtFull
    request.security(syminfo.tickerid, tgtTf, jsZonesHTF())
else
    [array.new<float>(), array.new<float>(), array.new<int>(), array.new<float>(), array.new<float>(), array.new<int>()]

// ============================== ENGINE =======================================
bool aBuy  = false
bool aSell = false
bool aFill = false
bool aExit = false

if barstate.isconfirmed
    // ---- trading day, rolls at 18:00 NY (A8)
    if mNow >= 1080
        sawEve := true
    if bar_index == 0 or (sawEve ? cross18 : newDay)
        if bar_index > 0
            koDay += 1
        S.days += 1
        dayName := str.format_time(mNow >= 1080 ? time + 21600000 : time, "yyyy-MM-dd", NY)

    // ---- key levels born at this bar's open (R2, A2)
    if newDay and bar_index > 0
        if dOk and not na(dH)
            if usePD
                addLvl(dH, "PDH", 1, 1, time)
                addLvl(dL, "PDL", -1, 1, time)
            if useMon and dCnt == 1
                addLvl(dH, "Monday High", 1, 2, time)
                addLvl(dL, "Monday Low", -1, 2, time)
        dOk := true
        dCnt := newWeek ? 1 : dCnt + 1
        if useOpen
            addLvl(open, "Daily Open", 0, 1, time)
        dH := high
        dL := low
        dOpen := open
    else
        dH := na(dH) ? high : math.max(dH, high)
        dL := na(dL) ? low : math.min(dL, low)
    if newWeek and bar_index > 0
        if wOk and not na(wH)
            if usePW
                addLvl(wH, "PWH", 1, 2, time)
                addLvl(wL, "PWL", -1, 2, time)
            if useMid
                addLvl((wH + wL) / 2, "PW Mid", 0, 2, time)
        wOk := true
        if useOpen
            addLvl(open, "Weekly Open", 0, 2, time)
        wH := high
        wL := low
    else
        wH := na(wH) ? high : math.max(wH, high)
        wL := na(wL) ? low : math.min(wL, low)
    if newMonth and bar_index > 0
        if mOk and not na(mH)
            if usePM
                addLvl(mH, "PMH", 1, 2, time)
                addLvl(mL, "PML", -1, 2, time)
            if useMid
                addLvl((mH + mL) / 2, "PM Mid", 0, 2, time)
        mOk := true
        if useOpen
            addLvl(open, "Monthly Open", 0, 2, time)
        mH := high
        mL := low
    else
        mH := na(mH) ? high : math.max(mH, high)
        mL := na(mL) ? low : math.min(mL, low)
    if useOpen and newQtr and bar_index > 0
        addLvl(open, "Quarterly Open", 0, 2, time)
    if useOpen and newYear and bar_index > 0
        addLvl(open, "Yearly Open", 0, 2, time)
    if inAs
        asH := wasAs ? math.max(asH, high) : high
        asL := wasAs ? math.min(asL, low) : low
    else if wasAs
        addLvl(asH, "Asia High", 1, 3, time)
        addLvl(asL, "Asia Low", -1, 3, time)
    wasAs := inAs
    if inLn
        lnH := wasLn ? math.max(lnH, high) : high
        lnL := wasLn ? math.min(lnL, low) : low
    else if wasLn
        addLvl(lnH, "London High", 1, 3, time)
        addLvl(lnL, "London Low", -1, 3, time)
    wasLn := inLn

    // ---- full history: refresh the target RBs whenever a target-timeframe candle closes (R5)
    if tgtFull and (tNew or tLast or array.size(pool) == 0) and not na(zbT)
        array.clear(pool)
        if zbT.size() > 0
            for i = 0 to zbT.size() - 1
                float hi = zbT.get(i)
                float bt = zbB.get(i)
                array.push(pool, Zone.new(bull=false, tip=hi, edge=bt, ce=(hi + bt) / 2, formT=zbX.get(i)))
        if zuT.size() > 0
            for i = 0 to zuT.size() - 1
                float bb = zuT.get(i)
                float lo = zuB.get(i)
                array.push(pool, Zone.new(bull=true, tip=lo, edge=bb, ce=(lo + bb) / 2, formT=zuX.get(i)))

    // ---- a target RB ends once a wick trades past its tip (R1, as JS RB)
    if array.size(pool) > 0
        for i = array.size(pool) - 1 to 0
            Zone z = array.get(pool, i)
            if (na(z.endBar) or bar_index > z.endBar) and (z.bull ? low < z.tip : high > z.tip)
                array.remove(pool, i)

    // ---- every live signal through this bar (A3-A6)
    if array.size(sigs) > 0
        for s in sigs
            if not s.resolved
                bool expS = s.setup == "Sweep" ? bar_index - s.sigBar > limBars : S.n4h > s.n4hAt
                for m = 0 to 3
                    Trade t = tradeAt(s, m)
                    [gotFill, gotDone, gotCancel] = stepTrade(t, s.bull, expS and not t.mkt, flatNow)
                    if m == selIdx and t.valid
                        if gotFill
                            aFill := true
                            alert(dirTxt(s) + " " + syminfo.ticker + " filled @ " + px(t.entry) + "  SL " + px(t.stop) + "  TP " + px(t.tgt) + "  (" + str.tostring(t.rr, "0.0") + "R)", alert.freq_once_per_bar_close)
                            if s.drawn and not na(s.lnE)
                                line.set_style(s.lnE, line.style_solid)
                                line.set_style(s.lnT, line.style_solid)
                                line.set_style(s.lnS, line.style_solid)
                                label.set_text(s.tgE, tagTxtE(s, t))
                        bool shownDone = useM ? t.doneM : t.doneF
                        bool justDone  = shownDone and (useM ? t.exitM : t.exitF) == bar_index
                        if justDone
                            aExit := true
                            float rr = useM ? t.rM : t.r
                            alert(dirTxt(s) + " " + syminfo.ticker + " closed " + fmtR(rr) + " @ " + px(useM ? t.pxM : t.pxF), alert.freq_once_per_bar_close)
                            if s.drawn
                                finishSig(s)
                        if gotCancel and s.drawn
                            cancelSig(s)
                if isOver(s.t0) and isOver(s.t1) and isOver(s.t2) and isOver(s.t3)
                    s.resolved := true
                    countSig(s)
                else if s.drawn and isLive(selT(s))
                    extendSig(s)

    // ---- chart history: target-timeframe RBs built from the chart's bars (R1, R5)
    [h1, h2] = aggStep(aT, tNew, tLast)
    for k = 0 to 1
        Candle ck = k == 0 ? h1 : h2
        if not na(ck) and not tgtFull
            [nb, nu] = jsStep(aT, ck)
            for j = 0 to 1
                bool bull = j == 1
                if (bull ? nu : nb) > 0
                    Zone z = zoneOf(ck, bull)
                    bool gone = ck.late and (bull ? low < z.tip : high > z.tip)
                    if not gone
                        array.push(pool, z)
                        if array.size(pool) > 500
                            array.shift(pool)

    // ---- entry-timeframe candles: Sweep signals (R1, R3)
    [e1, e2] = aggStep(aE, eNew, eLast)
    for k = 0 to 1
        Candle ck = k == 0 ? e1 : e2
        if not na(ck)
            // R7: confirmation entries waiting on this candle's close
            for s in sigs
                Trade w = s.t3
                if not s.resolved and w.wait and ck.t > s.rb.formT
                    w.waitN += 1
                    if s.bull ? ck.c > w.cisd : ck.c < w.cisd
                        arm(w, s.bull, ck.late ? close : ck.c)
                        if selIdx == 3
                            if w.valid
                                aFill := true
                                if s.drawn
                                    drawPos(s)
                                    if not na(s.lb)
                                        label.set_text(s.lb, lblTxt(s, w))
                                        label.set_tooltip(s.lb, sigTip(s, w))
                                alert(dirTxt(s) + " " + syminfo.ticker + " CONFIRMED · enter now " + px(w.entry) + "  SL " + px(w.stop) + "  TP " + px(w.tgt) + "  R:R " + str.tostring(w.rr, "0.0") + ctsTxt(w), alert.freq_once_per_bar_close)
                            else if s.drawn
                                cancelSig(s)
                    else if w.waitN >= confWin
                        w.wait := false
                        w.cancelled := true
                        w.why := "No confirmation within " + str.tostring(confWin) + " candles"
                        if selIdx == 3 and s.drawn
                            cancelSig(s)
            [nb, nu] = jsStep(aE, ck)
            for j = 0 to 1
                bool bull = j == 1
                if (bull ? nu : nb) > 0
                    Zone z = zoneOf(ck, bull)
                    z.cisd := cisdOf(aE, ck, bull)
                    // A1: a late RB is dropped if this bar already traded past its tip
                    bool gone = ck.late and (bull ? low < z.tip : high > z.tip)
                    if not gone
                        array.push(c5, z)
                        if array.size(c5) > 300
                            array.shift(c5)
                        if useSweep
                            array<Lvl> hits = sweptBy(ck, bull)
                            if array.size(hits) > 0 and canSignal(bull, blocked) and (not reqPd or pdOf(bull, z))
                                string names = ""
                                int grp = 9
                                for lv in hits
                                    names := names == "" ? lv.name : names + " + " + lv.name
                                    grp := math.min(grp, lv.grp)
                                    if bull
                                        lv.usedBull := true
                                    else
                                        lv.usedBear := true
                                z.swept := true
                                Sig s = mkSig(z, bull, "Sweep", names, grp, ck.late ? close : ck.c)
                                if not selT(s).valid and showSkip
                                    drawSkip(s)
                                if selT(s).valid
                                    drawSig(s)
                                    Trade t = selT(s)
                                    if bull
                                        aBuy := true
                                    else
                                        aSell := true
                                    alert(dirTxt(s) + " " + syminfo.ticker + " · " + setupTxt(s) + "\n" + entryName(s, selIdx) + " " + px(t.entry) + "  SL " + px(t.stop) + "  TP " + px(t.tgt) + "  R:R " + str.tostring(t.rr, "0.0") + ctsTxt(t), alert.freq_once_per_bar_close)
            remember(aE, ck)
            // R3: a high or low a 5m candle closed beyond is broken
            for lv in lvls
                if lv.side != 0 and not lv.broken and lv.bornT <= ck.t
                    if lv.side == 1 ? ck.c > lv.price : ck.c < lv.price
                        lv.broken := true

    // ---- 4H candles: the previous 4H high / low, and 4H RB signals (R2, R4)
    [f1, f2] = aggStep(a4, fNew, fLast)
    for k = 0 to 1
        Candle ck = k == 0 ? f1 : f2
        if not na(ck)
            S.n4h += 1
            int bt = ck.late ? time : time_close
            if use4H
                addLvl(ck.h, "Prev 4H High", 1, 0, bt)
                addLvl(ck.l, "Prev 4H Low", -1, 0, bt)
            if use4hRb
                Zone zHi = na
                Zone zLo = na
                for zc in c5
                    if zc.formT >= ck.t and zc.formT < bt
                        if not zc.bull and zc.tip == ck.h
                            zHi := zc
                        if zc.bull and zc.tip == ck.l
                            zLo := zc
                for j = 0 to 1
                    Zone z = j == 0 ? zHi : zLo
                    if not na(z) and not z.swept
                        bool bull = z.bull
                        if canSignal(bull, blocked) and (not reqPd or pdOf(bull, z))
                            z.swept := true
                            Sig s = mkSig(z, bull, "4H RB", bull ? "4H Low RB" : "4H High RB", 0, close)
                            if not selT(s).valid and showSkip
                                drawSkip(s)
                            if selT(s).valid
                                drawSig(s)
                                Trade t = selT(s)
                                if bull
                                    aBuy := true
                                else
                                    aSell := true
                                alert(dirTxt(s) + " " + syminfo.ticker + " · " + setupTxt(s) + "\n" + entryName(s, selIdx) + " " + px(t.entry) + "  SL " + px(t.stop) + "  TP " + px(t.tgt) + "  R:R " + str.tostring(t.rr, "0.0") + ctsTxt(t), alert.freq_once_per_bar_close)

    // ---- replaced and broken levels go
    if array.size(lvls) > 0
        for i = array.size(lvls) - 1 to 0
            Lvl lv = array.get(lvls, i)
            if not na(lv.deadT) or lv.broken
                array.remove(lvls, i)

    // ---- only the newest maxDraw signals keep their drawings; finished, undrawn ones go
    int kept = 0
    if array.size(sigs) > 0
        for i = array.size(sigs) - 1 to 0
            Sig s = array.get(sigs, i)
            if s.drawn
                kept += 1
                if kept > maxDraw
                    delSig(s)
            if s.resolved and not s.drawn
                array.remove(sigs, i)

// ============================== ALERTS =======================================
alertcondition(aBuy, "RB Flow BUY", "ST RB Flow BUY signal")
alertcondition(aSell, "RB Flow SELL", "ST RB Flow SELL signal")
alertcondition(aFill, "RB Flow limit filled", "ST RB Flow limit entry filled")
alertcondition(aExit, "RB Flow trade closed", "ST RB Flow trade closed")

// ============================ STATS TABLE ====================================
tc(table t, int c, int r, string s, color fg, color bg, string tip) =>
    table.cell(t, c, r, s, text_color=fg, bgcolor=bg, text_size=size.small, tooltip=tip)

rColor(float v, int n, color txt) =>
    n > 0 ? (v > 0 ? colTp : v < 0 ? colSl : txt) : txt

var table stat = na
if barstate.islast and tblMode != "Off"
    tblPos = switch statsPos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        "Middle Right" => position.middle_right
        => position.top_right
    if na(stat)
        stat := table.new(tblPos, 6, 32, border_width=1, frame_color=color.new(color.gray, 40), frame_width=1)
    else
        table.set_position(stat, tblPos)
    color hdr = color.new(color.gray, 20)
    color row = color.new(color.black, 55)
    color txt = color.white
    table.clear(stat, 0, 0, 5, 31)
    int live = 0
    for s in sigs
        if not s.resolved
            live += 1

    tc(stat, 0, 0, "RB Flow " + entTfIn + " → " + tgtTfIn, txt, hdr, "")
    tc(stat, 1, 0, "Setups", txt, hdr, "Signals that met a setup.")
    tc(stat, 2, 0, str.tostring(S.setups), txt, hdr, "")
    tc(stat, 3, 0, "Skipped", txt, hdr, "Setups the shown entry didn't trade (no target far enough, or the stop too wide). Grey ✕ on the chart. " + str.tostring(live) + " signals are live now.")
    tc(stat, 4, 0, str.tostring(S.noTgt), txt, hdr, "")
    tc(stat, 5, 0, str.tostring(S.days) + " days", txt, hdr, "Trading days on the chart")

    string tipF = "Whole position to the target RB, same stop. Average R per trade."
    tc(stat, 0, 1, "Entry", txt, hdr, "")
    tc(stat, 1, 1, "Trades", txt, hdr, "Filled trades (of signals with a valid target for this entry)")
    tc(stat, 2, 1, "Hit " + tgtTfIn, txt, hdr, "Share of trades that reached the target RB before the stop.")
    tc(stat, 3, 1, "Avg R", txt, hdr, tipF)
    tc(stat, 4, 1, "Net R", txt, hdr, tipF)
    tc(stat, 5, 1, "½ + BE", txt, hdr, "Half off at " + str.tostring(tp1R) + "R, stop to breakeven, the rest to the target. Average R · win %.")
    array<string> eNames = array.from("RB close", "Body edge", "CE 50%", "Confirm")
    for m = 0 to 3
        int   n  = array.get(eFill, m)
        float sF = array.get(eSumF, m)
        float sM = array.get(eSumM, m)
        tc(stat, 0, 2 + m, (m == selIdx ? "▶ " : "") + array.get(eNames, m), txt, row, m == 3 ? "Waits for a 5m close back through the CISD level, then enters at that close." : "")
        tc(stat, 1, 2 + m, str.tostring(n) + " / " + str.tostring(array.get(eValid, m)), txt, row, "")
        tc(stat, 2, 2 + m, f_pct(array.get(eHit, m), n), txt, row, "")
        tc(stat, 3, 2 + m, n > 0 ? fmtR(sF / n) : "-", rColor(sF, n, txt), row, "")
        tc(stat, 4, 2 + m, n > 0 ? fmtR(sF) : "-", rColor(sF, n, txt), row, "")
        tc(stat, 5, 2 + m, n > 0 ? fmtR(sM / n) + " · " + f_pct(array.get(eWinM, m), n) : "-", rColor(sM, n, txt), row, "")

    int greens = 0
    for v in dR
        if v > 0
            greens += 1
    tc(stat, 0, 6, "▶ " + (useM ? "½ + BE" : "Full"), txt, hdr, "The shown entry and result mode, used below, on the chart and in alerts.")
    tc(stat, 1, 6, "Max DD " + str.tostring(S.maxDD, "0.0") + "R", txt, hdr, "Largest drop from a peak, in R, trade by trade.")
    tc(stat, 2, 6, "Lose run " + str.tostring(S.maxLose), txt, hdr, "Longest run of losing trades.")
    tc(stat, 3, 6, "Green days", txt, hdr, "")
    tc(stat, 4, 6, f_pct(greens, array.size(dR)), txt, hdr, str.tostring(greens) + " of " + str.tostring(array.size(dR)) + " days with a trade")
    tc(stat, 5, 6, "Net " + fmtR(S.eq), rColor(S.eq, 1, txt), hdr, "")

    if bkTbl
        tc(stat, 0, 7, "Breakdown ▶", txt, hdr, "Trades of the shown entry, split several ways. Compare each row with the ▶ row above. Trust a row only with about 100 trades or more.")
        tc(stat, 1, 7, "N", txt, hdr, "")
        tc(stat, 2, 7, "Win%", txt, hdr, "")
        tc(stat, 3, 7, "Avg R", txt, hdr, "")
        tc(stat, 4, 7, "Net R", txt, hdr, "")
        tc(stat, 5, 7, "", txt, hdr, "")
        array<string> bNames = array.from("Sweep", "4H RB", "Longs", "Shorts", "Level: 4H H/L", "Level: day", "Level: week+", "Level: session", "Asia 18–02", "London 02–08:30", "NY AM 08:30–12", "NY PM 12–18", "Target: " + tgtTfIn + " RB", "Target: 4H level", "Target: fixed R", "With the daily open (P/D)", "Against the daily open", "RB closed with the trade", "RB closed against it", "Target < 5R", "Target 5–10R", "Target > 10R", "Stop ≤ 15 pts", "Stop > 15 pts")
        for k = 0 to BK_N - 1
            int   n = array.get(bN, k)
            float v = array.get(bSum, k)
            tc(stat, 0, 8 + k, array.get(bNames, k), txt, row, "")
            tc(stat, 1, 8 + k, str.tostring(n), txt, row, "")
            tc(stat, 2, 8 + k, f_pct(array.get(bW, k), n), txt, row, "")
            tc(stat, 3, 8 + k, n > 0 ? fmtR(v / n) : "-", rColor(v, n, txt), row, "")
            tc(stat, 4, 8 + k, n > 0 ? fmtR(v) : "-", rColor(v, n, txt), row, "")
            tc(stat, 5, 8 + k, "", txt, row, "")
    if dayTbl
        tc(stat, 0, 7, "Day (newest)", txt, hdr, "Every trade is also in the Pine Logs.")
        tc(stat, 1, 7, "Trades", txt, hdr, "")
        tc(stat, 2, 7, "W–L", txt, hdr, "")
        tc(stat, 3, 7, "Net R", txt, hdr, "")
        tc(stat, 4, 7, "", txt, hdr, "")
        tc(stat, 5, 7, "", txt, hdr, "")
        int nD = array.size(dKey)
        for j = 0 to 9
            int i = nD - 1 - j
            if i >= 0
                int   n = array.get(dN, i)
                int   w = array.get(dW, i)
                float v = array.get(dR, i)
                tc(stat, 0, 8 + j, array.get(dName, i), txt, row, "")
                tc(stat, 1, 8 + j, str.tostring(n), txt, row, "")
                tc(stat, 2, 8 + j, str.tostring(w) + "–" + str.tostring(n - w), txt, row, "")
                tc(stat, 3, 8 + j, fmtR(v), rColor(v, n, txt), row, "")
                tc(stat, 4, 8 + j, "", txt, row, "")
                tc(stat, 5, 8 + j, "", txt, row, "")
